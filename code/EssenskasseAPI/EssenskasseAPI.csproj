<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>Kretchen001</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <!-- Abhaengigkeiten von MySql.Data mit bekannten Sicherheitsluecken: bewusst auf aktuelle Versionen angehoben -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="SerilogTimings" Version="3.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Xunit.Priority" Version="1.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modells\Modells.csproj" />
  </ItemGroup>

  <!-- Die Update-Skripte werden in die API eingebettet und beim Start automatisch angewendet (siehe DatabaseMigrator). -->
  <ItemGroup>
    <EmbeddedResource Include="..\MySqlScripts\update_v*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
