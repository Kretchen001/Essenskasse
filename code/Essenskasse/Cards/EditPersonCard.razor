@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ToastService ToastService

<style>
    .Rahmen {
        border: 3px solid;
        border-color: darkgreen;
        border-radius: 5px;
        padding: 0.5rem;
    }

    .Zeile {
        margin-top: 0.1rem;
        margin-bottom: 0.1rem;
    }
</style>

<div class="Rahmen">
    <div class="row Zeile" style="border-bottom: 1px solid; border-bottom-color: lightgray;">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.guid)] @_loc[nameof(RessourceAppStrings.cannotBeChanged)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.guid)]" id="idGuid"
                   style="width: 100%;" @bind-value="selectedPerson">
        </div>
    </div>
    <div class="row Zeile" style="border-bottom: 1px solid; border-bottom-color: lightgray">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.name)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.name)]" id="idName"
                   style="width: 100%;" @bind-value="person.Name">
        </div>
    </div>
    <div class="row Zeile">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.email)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.email)]" id="idEmail"
                   style="width: 100%;" @bind-value="person.Email">
        </div>
    </div>
    <div class="row Zeile">
        <div class="col-lg-2">
        </div>
        <div class="col-lg-4">
            <button @onclick="() => requestPersonFromTheGuidInput()">
                @_loc[nameof(RessourceAppStrings.loadData)]
            </button>
        </div>
        <div class="col-lg-4">
            <button disabled="@dataNotLoadYet" @onclick="() => commitChangesToApi()">
                @_loc[nameof(RessourceAppStrings.acceptChanges)]
            </button>
        </div>
        <div class="col-lg-2">
        </div>
    </div>
</div>

@code {
    /// <summary></summary>
    [Parameter]
    public EventCallback OnChangeCommit { get; set; }

    /// <summary></summary>
    [Parameter]
    public Person person { get; set; } = new Person();
    private Person safePerson = new Person();

    private string selectedPerson = "";

    private bool dataNotLoadYet = true;

    ElementReference inputTypeFileElement;

    private async void requestPersonFromTheGuidInput () {
        if (Guid.TryParse(selectedPerson, out _)) {
            HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "person/perGuid"),
                Headers = {
                    { "guid", Guid.Parse(selectedPerson).ToString() }
                }
            };

            HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

            if (response.IsSuccessStatusCode) {
                person = JsonConvert.DeserializeObject<Person>(await response.Content.ReadAsStringAsync())!;
                person.Name = Uri.UnescapeDataString(person.Name);
                person.Email= Uri.UnescapeDataString(person.Email);
                safePerson = JsonConvert.DeserializeObject<Person>(JsonConvert.SerializeObject(person))!;
                dataNotLoadYet = false;
                base.StateHasChanged();
            }
            else {
                ToastService.ShowToast("Person nicht verfügbar!\nBitte Guid überprüfen.", ToastLevel.Warning);
            }
        }
        else {
                ToastService.ShowToast("Keine Guid da!", ToastLevel.Error);
        }
    }

    private async void commitChangesToApi() {
        if (person.Name.Equals(safePerson.Name) && person.Email.Equals(safePerson.Email)) {
            ToastService.ShowToast("Keine Änderungen", ToastLevel.Info);
            return;
        }
        Console.WriteLine(selectedPerson);
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Put,
                RequestUri = new Uri(Config["API-Adress"] + "person/update"),
                Headers = {
                    { "guid", Guid.Parse(selectedPerson).ToString() },
                    { "name", person.Name },
                    { "email", person.Email }
                }
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            safePerson = new Person(new Guid(), "", "", new Money());
            person = new Person(new Guid(), "", "", new Money());
            dataNotLoadYet = true;
            await OnChangeCommit.InvokeAsync();
        }
        else {
            ToastService.ShowToast("Person nicht verfügbar!\nBitte Guid überprüfen.", ToastLevel.Warning);
        }
    }
}