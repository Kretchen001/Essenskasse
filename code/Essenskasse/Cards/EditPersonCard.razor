@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ToastService ToastService

<style>
    .Rahmen {
        border: 3px solid;
        border-color: darkgreen;
        border-radius: 5px;
        padding: 0.5rem;
    }

    .Zeile {
        margin-top: 0.1rem;
        margin-bottom: 0.1rem;
    }
</style>

<div class="Rahmen">
    <div class="row Zeile" style="border-bottom: 1px solid; border-bottom-color: lightgray;">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.guid)] @_loc[nameof(RessourceAppStrings.cannotBeChanged)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.guid)]" id="idGuid"
                   style="width: 100%;" @bind-value="selectedPerson">
        </div>
    </div>
    <div class="row Zeile" style="border-bottom: 1px solid; border-bottom-color: lightgray">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.name)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.name)]" id="idName"
                   style="width: 100%;" @bind-value="person.Name" disabled="@dataNotLoadYet">
        </div>
    </div>
    <div class="row Zeile">
        <div class="col-lg-4">
            <label>
                @_loc[nameof(RessourceAppStrings.email)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" placeholder="@_loc[nameof(RessourceAppStrings.email)]" id="idEmail"
                   style="width: 100%;" @bind-value="person.Email" disabled="@dataNotLoadYet">
        </div>
    </div>
    <div class="row Zeile">
        <div class="col-lg-2">
        </div>
        <div class="col-lg-4">
            <button type="button" class="btn-primary" data-dismiss="modal" style="border-radius:8px" @onclick="() => requestPersonFromTheGuidInput()">
                @_loc[nameof(RessourceAppStrings.loadData)]
            </button>
        </div>
        <div class="col-lg-4">
            <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px" disabled="@dataNotLoadYet" @onclick="() => commitChangesToApi()">
                @_loc[nameof(RessourceAppStrings.acceptChanges)]
            </button>
        </div>
        <div class="col-lg-2">
        </div>
    </div>
</div>
