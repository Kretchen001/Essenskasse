@inject IStringLocalizer<App> _loc

<div class="row" style="border: 2px dotted gray; border-radius:8px; margin: 2px; padding: 0.5rem">
    <div class="col-lg-2" style="text-align: center; justify-content: center;">
        @DesignationOfPerson
    </div>
    <div class="col-lg-2" style="text-align: right;">
        @Payment.DateTime.ToString("dddd, dd. MMMM yyyy")
    </div>
    <div class="col-lg-2" style="text-align: right;">
        @Payment.Amount.ToString()
    </div>
    <div class="col-lg-3" style="align-items: center;">
        @GetCommentUnescape()
    </div>
    <div class="col-lg-3" style="display: flex; justify-content: center;">
        <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px" @onclick="() => ClickOnChange()">
            @_loc[nameof(RessourceAppStrings.change)]
        </button>
    </div>
</div>
