@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc

@if (PositivSaldo) {
    <div style="border: 0.2rem; border-style: outset; border-radius: 5px; margin: 0.25rem; padding: 0.25rem;
                background-color: aquamarine; color: black;">
        <h5>@Person.Name</h5>

        <label>
            @Person.Saldo.ToString()
        </label>
    </div>
}
else {
    <div style="border: 0.2rem; border-style: outset; border-radius: 5px; margin: 0.25rem; padding: 0.25rem;
                background-color: mistyrose; color: black;">
        <h5>@Person.Name</h5>

        <label>
            @Person.Saldo.ToString()
        </label>
    </div>
}


@code {
    [Parameter]
    public Person Person { get; set; } = new Person();

    [Parameter]
    public bool PositivSaldo { get; set; } = false;

}
