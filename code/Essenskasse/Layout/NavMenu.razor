                        </span> @_loc[nameof(RessourceAppStrings.settings)]
                    </NavLink>
                </div>
                @if (AppData.AccessToken is not null) {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="changeEntity" Match="NavLinkMatch.All">
                            <span aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                                    <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9" />
                                    <path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z" />
                                </svg>
                            </span> @_loc[nameof(RessourceAppStrings.changes)]
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        @* Leerbereich füllen, um div nach unten zu schieben *@
        <div class="flex-grow-1"></div>
        <div class="p-3 d-flex justify-content-md-start justify-content-end">
            <label style="color: lightgray">
                v @Config["Version"]![0..@Config["Version"]!.LastIndexOf(".")]
            </label>
        </div>
    </nav>
</div>


@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() {
        collapseNavMenu = !collapseNavMenu;
    }

    /// <summary></summary>
    /// <returns></returns>
    public async Task ReloadNavMenu() {
        base.StateHasChanged();
    }
}
