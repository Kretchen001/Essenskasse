@inherits LayoutComponentBase

@inject AppDataService AppData
@inject ILocalStorageService LocalStorage
@inject ThemeService themeService
@inject NavigationManager Navi

@inject AuthStateService AuthState

<ToastCard />

<div class="page">
    <div class="sidebar">
        <NavMenu @ref="navMenu" />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <AuthorizeView>
                <NotAuthorized>
                    <div>
                        Not authorized
                    </div>
                    <button @onclick="@(() => UpdateAuthentication(true))">
                        Authentifiziere dich!
                    </button>
                </NotAuthorized>
                <Authorizing>
                    Authorizing
                </Authorizing>
                <Authorized>
                    Authorized
                    <button @onclick="@(() => UpdateAuthentication(false))">
                        Tschüss
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code
{
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    private void UpdateAuthentication(bool? isAuthenticated) {
        if (!isAuthenticated.HasValue) {
            AuthStateService.IsAuthenticating = true;
        }
        else {
            AuthStateService.IsAuthenticating = false;
            AuthStateService.IsAuthenticated = isAuthenticated.Value;
        }

        AuthState.NotifyAuthenticationStateChanged();
    }
}