@inherits LayoutComponentBase

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ILocalStorageService LocalStorage
@inject AppDataService AppData
@inject ToastService ToastService
@inject ThemeService themeService

@inject AuthStateService AuthState

<ToastCard />

<div class="page">
    <div class="sidebar">
        <NavMenu @ref="navMenu" />
    </div>

    <main>
        <div class="top-row ek-topbar px-4 auth">
            <AuthorizeView>
                <NotAuthorized>
                    <button type="button" class="ek-btn ek-btn-primary" @onclick="() => ShowLoginModal()">
                        @_loc[nameof(RessourceAppStrings.signIn)]
                    </button>
                    <LoginModal @ref="LoginModel">
                        <div class="row">
                            <div class="col-lg-4">
                                Benutzername
                            </div>
                            <div class="col-lg-8">
                                <input @bind=nameToLogin/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                Passwort
                            </div>
                            <div class="col-lg-8">
                                <input @bind=passwordToLogin/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                Berechtigungsebene
                            </div>
                            <div class="col-lg-8">
                                <input @bind=roleToLogin type="number"/>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px;" @onclick="() => LoginUser()">
                                Anmelden
                            </button>
                        </div>
                    </LoginModal>
                </NotAuthorized>
                <Authorizing>
                    <span class="ek-topbar-busy" role="status">@_loc[nameof(RessourceAppStrings.authorizing)]</span>
                </Authorizing>
                <Authorized>
                    @if (currentUserName.Length > 0) {
                        <div class="ek-user" title="@_loc[nameof(RessourceAppStrings.signedInAs), currentUserName]">
                            <span class="ek-user-avatar" aria-hidden="true">@PersonText.Initials(currentUserName)</span>
                            <span class="ek-user-name">@currentUserName</span>
                        </div>
                    }
                    <button type="button" class="ek-btn" @onclick="() => LogoutUser()">
                        @_loc[nameof(RessourceAppStrings.signOut)]
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
