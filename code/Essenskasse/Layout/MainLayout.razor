@inherits LayoutComponentBase

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ILocalStorageService LocalStorage
@inject AppDataService AppData
@inject ToastService ToastService
@inject ThemeService themeService
@inject UserSettingsStore UserSettings
@inject NavigationManager NavManager

@inject AuthStateService AuthState

<ToastCard />

<div class="page">
    <div class="sidebar">
        <NavMenu @ref="navMenu" />
    </div>

    <main>
        <div class="top-row ek-topbar px-4 auth">
            <AuthorizeView>
                <NotAuthorized>
                    <button type="button" class="ek-btn ek-btn-primary" @onclick="() => ShowLoginModal()">
                        @_loc[nameof(RessourceAppStrings.signIn)]
                    </button>
                    <LoginModal @ref="LoginModel" Title="@_loc[nameof(RessourceAppStrings.signIn)]" FocusElementId="ek-login-name">
                        <form class="ek-login-form" @onsubmit="LoginUser" @onsubmit:preventDefault>
                            <label class="ek-field">
                                <span>@_loc[nameof(RessourceAppStrings.userName)]</span>
                                <input id="ek-login-name" type="text" class="ek-input" autocomplete="username"
                                       autocapitalize="none" spellcheck="false"
                                       @bind="nameToLogin" @bind:event="oninput" />
                            </label>
                            <label class="ek-field">
                                <span>@_loc[nameof(RessourceAppStrings.password)]</span>
                                <span class="ek-pw">
                                    <input id="ek-login-password" type="@(showPassword ? "text" : "password")" class="ek-input"
                                           autocomplete="current-password"
                                           @bind="passwordToLogin" @bind:event="oninput" />
                                    <button type="button" class="ek-icon-btn" @onclick="() => showPassword = !showPassword"
                                            aria-pressed="@showPassword"
                                            title="@(showPassword ? _loc[nameof(RessourceAppStrings.hidePassword)] : _loc[nameof(RessourceAppStrings.showPassword)])"
                                            aria-label="@(showPassword ? _loc[nameof(RessourceAppStrings.hidePassword)] : _loc[nameof(RessourceAppStrings.showPassword)])">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                        </svg>
                                    </button>
                                </span>
                            </label>
                            <details class="ek-advanced">
                                <summary>@_loc[nameof(RessourceAppStrings.advanced)]</summary>
                                <label class="ek-field">
                                    <span>@_loc[nameof(RessourceAppStrings.permissionLevel)]</span>
                                    <input type="number" class="ek-input" @bind="roleToLogin" />
                                </label>
                            </details>
                            @if (loginFailed) {
                                <p class="ek-hint is-error" role="alert">@_loc[nameof(RessourceAppStrings.loginFailedRetry)]</p>
                            }
                            <div class="ek-login-actions">
                                <button type="submit" class="ek-btn ek-btn-primary" disabled="@isLoggingIn">
                                    @(isLoggingIn ? _loc[nameof(RessourceAppStrings.signingIn)] : _loc[nameof(RessourceAppStrings.signIn)])
                                </button>
                                <button type="button" class="ek-btn" @onclick="() => LoginModel!.Close()">
                                    @_loc[nameof(RessourceAppStrings.cancel)]
                                </button>
                            </div>
                        </form>
                    </LoginModal>
                </NotAuthorized>
                <Authorizing>
                    <span class="ek-topbar-busy" role="status">@_loc[nameof(RessourceAppStrings.authorizing)]</span>
                </Authorizing>
                <Authorized>
                    @if (currentUserName.Length > 0) {
                        <div class="ek-user" title="@_loc[nameof(RessourceAppStrings.signedInAs), currentUserName]">
                            <span class="ek-user-avatar" aria-hidden="true">@PersonText.Initials(currentUserName)</span>
                            <span class="ek-user-name">@currentUserName</span>
                        </div>
                    }
                    <button type="button" class="ek-btn" @onclick="() => LogoutUser()">
                        @_loc[nameof(RessourceAppStrings.signOut)]
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
