@inherits LayoutComponentBase

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ILocalStorageService LocalStorage
@inject AppDataService AppData
@inject ToastService ToastService
@inject ThemeService themeService

@inject AuthStateService AuthState

<ToastCard />

<div class="page">
    <div class="sidebar">
        <NavMenu @ref="navMenu" />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <AuthorizeView>
                <NotAuthorized>
                    <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px;" @onclick="() => ShowLoginModal()">
                        Anmelden
                    </button>
                    <LoginModal @ref="LoginModel">
                        <div class="row">
                            <div class="col-lg-4">
                                Benutzername
                            </div>
                            <div class="col-lg-8">
                                <input />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                Passwort
                            </div>
                            <div class="col-lg-8">
                                <input />
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px;" @onclick="() => UpdateAuthentication(true)">
                                Anmelden
                            </button>
                        </div>
                    </LoginModal>
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex align-items-center">
                        Authorizing
                    </div>
                </Authorizing>
                <Authorized>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn-danger" data-dismiss="modal" style="border-radius:8px;" @onclick="@(() => UpdateAuthentication(false))">
                            Abmelden
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
