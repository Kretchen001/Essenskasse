@inject IStringLocalizer<App> _loc

@if (isOpen) {
    <div class="ek-login-backdrop" @onclick="Close"></div>
    <div class="ek-login" role="dialog" aria-modal="true" aria-labelledby="ek-login-title" tabindex="-1" @onkeydown="OnKeyDown">
        <div class="ek-login-head">
            <h2 id="ek-login-title" class="ek-login-title">@Title</h2>
            <button type="button" class="ek-icon-btn" aria-label="@_loc[nameof(RessourceAppStrings.close)]"
                    title="@_loc[nameof(RessourceAppStrings.close)]" @onclick="Close">✕</button>
        </div>
        <div class="ek-login-body">
            @ChildContent
        </div>
    </div>
}
