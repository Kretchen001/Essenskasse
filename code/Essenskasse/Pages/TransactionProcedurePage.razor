@page "/transactionProcedure"

@inject IStringLocalizer<App> _loc
@inject AuthStateService AuthState

<PageTitle>@_loc[nameof(RessourceAppStrings.coffeeFund)]</PageTitle>

<div class="ek-dash">
    <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.coffeeFund)]</h2>

    <div class="ek-cash-hero @(summary.Balance.IsPositiv() ? "ek-person-ok" : "ek-person-bad")">
        <div class="ek-cash-main">
            <span class="ek-cash-label">@_loc[nameof(RessourceAppStrings.cashBalanceCurrent)]</span>
            <span class="ek-cash-balance" aria-live="polite">@summary.Balance.ToString()</span>
        </div>
        <dl class="ek-cash-sums">
            <div>
                <dt>@_loc[nameof(RessourceAppStrings.coffeeTotalIn)]</dt>
                <dd class="is-in">+ @summary.Income.ToString()</dd>
            </div>
            <div>
                <dt>@_loc[nameof(RessourceAppStrings.coffeeTotalOut)]</dt>
                <dd class="is-out">- @summary.Expense.ToString()</dd>
            </div>
        </dl>
    </div>

    <AuthorizeView>
        <Authorized>
            <form class="ek-add ek-cash-form" @onsubmit="InsertNewTransaction" @onsubmit:preventDefault>
                <div class="ek-seg" role="group" aria-label="@_loc[nameof(RessourceAppStrings.coffeeFund)]">
                    <button type="button" class="is-in @(isPayout ? "" : "is-active")" aria-pressed="@(!isPayout)" @onclick="() => SetDirection(false)">
                        <span aria-hidden="true">↓</span> @_loc[nameof(RessourceAppStrings.coffeeDeposit)]
                    </button>
                    <button type="button" class="is-out @(isPayout ? "is-active" : "")" aria-pressed="@isPayout" @onclick="() => SetDirection(true)">
                        <span aria-hidden="true">↑</span> @_loc[nameof(RessourceAppStrings.coffeePayout)]
                    </button>
                </div>
                <div class="ek-add-fields ek-cash-fields">
                    <label class="ek-field">
                        <span>@_loc[nameof(RessourceAppStrings.amount)]</span>
                        <input type="text" inputmode="decimal" class="ek-input" autocomplete="off" placeholder="10,00"
                               @bind="amountText" @bind:event="oninput" />
                    </label>
                    <label class="ek-field">
                        <span>@_loc[nameof(RessourceAppStrings.comment)]</span>
                        <input type="text" class="ek-input" autocomplete="off" maxlength="200" @bind="comment" @bind:event="oninput" />
                    </label>
                    <button type="submit" class="ek-btn ek-btn-primary ek-add-submit" disabled="@(!AmountValid || isBooking)">
                        @_loc[nameof(RessourceAppStrings.coffeeBook)]
                    </button>
                </div>
                @if (AmountEntered && !AmountValid) {
                    <p class="ek-hint is-error" role="alert">@_loc[nameof(RessourceAppStrings.amountInvalid)]</p>
                }
                else if (AmountValid) {
                    <p class="ek-hint @(BalanceAfter.IsPositiv() ? "" : "is-warn")">
                        @_loc[nameof(RessourceAppStrings.coffeeBalanceAfter)]: <strong>@BalanceAfter.ToString()</strong>
                        @if (!BalanceAfter.IsPositiv()) {
                            <span> – @_loc[nameof(RessourceAppStrings.coffeeWouldGoNegative)]</span>
                        }
                    </p>
                }
            </form>
        </Authorized>
        <NotAuthorized>
            <div class="ek-cash-note">
                <p class="ek-hint">@_loc[nameof(RessourceAppStrings.coffeeSignInHint)]</p>
                <button type="button" class="ek-btn" @onclick="AuthState.RequestLogin">@_loc[nameof(RessourceAppStrings.signIn)]</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    @if (loading) {
        <ul class="ek-hist ek-cash-hist" aria-busy="true" aria-live="polite">
            @for (int i = 0; i < 4; i++) {
                <li class="ek-skeleton" aria-hidden="true"><span class="ek-skeleton-line"></span></li>
            }
        </ul>
    }
    else if (loadFailed) {
        <div class="ek-empty">
            <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.coffeeLoadFailed)]</p>
            <button type="button" class="ek-btn" @onclick="ReloadAsync">@_loc[nameof(RessourceAppStrings.retry)]</button>
        </div>
    }
    else if (transactions.Count == 0) {
        <div class="ek-empty">
            <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.coffeeNoEntries)]</p>
        </div>
    }
    else {
        @foreach (IGrouping<DateTime, TransactionProcedure> month in ShownByMonth) {
            <h4 class="ek-hist-month">@month.Key.ToString("MMMM yyyy")</h4>
            <ul class="ek-hist ek-cash-hist">
                @foreach (TransactionProcedure x in month) {
                    bool isIn = x.Amount.IsPositiv();
                    <li class="@(isIn ? "is-in" : "is-out")">
                        <span class="ek-cash-dir" aria-hidden="true">@(isIn ? "↓" : "↑")</span>
                        <span class="ek-hist-date">@x.DateTime.ToString("ddd, dd.MM. HH:mm")</span>
                        <span class="ek-hist-text">
                            <span class="ek-cash-kind">@(isIn ? _loc[nameof(RessourceAppStrings.coffeeDeposit)] : _loc[nameof(RessourceAppStrings.coffeePayout)])</span>
                            @x.Comment
                        </span>
                        <span class="ek-hist-amount">@x.Amount.ToString()</span>
                    </li>
                }
            </ul>
        }
        <div class="ek-hist-more">
            @if (transactions.Count <= visibleCount) {
                <span class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.endOfList)]</span>
            }
            else {
                <button type="button" class="ek-btn" @onclick="ShowMore">@_loc[nameof(RessourceAppStrings.buttonLoadMore)]</button>
            }
        </div>
    }
</div>
