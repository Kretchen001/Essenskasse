@page "/settings"

@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject NavigationManager Navi
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient HttpClient
@inject IJSRuntime JsRuntime
@inject IConfiguration Config
@inject ThemeService themeService
@inject ToastService ToastService

<PageTitle>@_loc[nameof(RessourceAppStrings.settings)]</PageTitle>

<h3>@_loc[nameof(RessourceAppStrings.settings)]</h3>

<style>
    #lila {
        background: rgb(200,116,217);
        background: linear-gradient(90deg, rgba(200,116,217,1) 0%, rgba(200,116,217,1) 35%, rgba(197,52,224,1) 45%, rgba(128,7,144,1) 70%, rgba(110,9,121,1) 90%, rgba(62,0,98,1) 100%);
    }
    #orange {
        background: rgb(217,194,116);
        background: linear-gradient(90deg, rgba(217,194,116,1) 0%, rgba(217,189,116,1) 35%, rgba(224,187,52,1) 45%, rgba(144,113,7,1) 70%, rgba(121,97,9,1) 90%, rgba(98,90,0,1) 100%);
    }
    #green {
        background: rgb(116,217,196);
        background: linear-gradient(90deg, rgba(116,217,196,1) 0%, rgba(116,217,192,1) 35%, rgba(52,224,176,1) 45%, rgba(7,144,108,1) 70%, rgba(9,121,88,1) 90%, rgba(0,98,71,1) 100%);
    }
    #red {
        background: rgb(217,116,116);
        background: linear-gradient(90deg, rgba(217,116,116,1) 0%, rgba(217,116,116,1) 35%, rgba(224,52,52,1) 45%, rgba(144,7,7,1) 70%, rgba(121,9,9,1) 90%, rgba(98,0,0,1) 100%);
    }
    #gray {
        background: rgb(224,222,222);
        background: linear-gradient(90deg, rgba(224,222,222,1) 0%, rgba(224,222,222,1) 35%, rgba(212,212,212,1) 45%, rgba(153,153,153,1) 70%, rgba(107,107,107,1) 90%, rgba(106,106,106,1) 100%);
    }
    #labelcolor {
        color: rgb(10,10,10);
    }
</style>

<div class="row align-items-center" id="gray" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.language)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right">
                <CultureSelector />
            </div>
            <div class="col-lg-6">
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="gray" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.colortheme)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">   
                <select @bind="@CurrentTheme">
                    @foreach (var entity in themeList) {
                        <option value="@entity.Key">@entity.Value</option>
                    }
                </select> 
            </div>
            <div class="col-lg-6" align="center">
                <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px" @onclick="() => SaveUserThemePersistentAsync()">
                    @_loc[nameof(RessourceAppStrings.savePermanent)]
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="green" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.singleColumn)] (@_loc[nameof(RessourceAppStrings.currentlySelected)])
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="IsSingleListWish">
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                <label class="form-check-label" for="flexSwitchCheckChecked" style="color: white">@ReturnListWish</label>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="green" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.provider)]) @_loc[nameof(RessourceAppStrings.turnOn)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="FilterShowProvider">
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                <label class="form-check-label" for="flexSwitchCheckChecked" style="color: white">@FilterShowProviderString</label>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="green" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.person)]) @_loc[nameof(RessourceAppStrings.turnOn)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="FilterShowPerson">
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                <label class="form-check-label" for="flexSwitchCheckChecked" style="color: white">@FilterShowPersonString</label>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="orange" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.paymentsToBeLoaded)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input type="number" @bind="LoadAmountPayments" />
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="orange" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.ordersToBeLoaded)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input type="number" @bind="LoadAmountOrders" />
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="red" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.limitValuePositivBalance)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input type="number" @bind="DashboardMoneyLimitInt">
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                <label style="color: white">
                    @_loc[nameof(RessourceAppStrings.current)]: @DashboardMoneyLimit.ToString()
                </label>
            </div>
        </div>
    </div>
</div>

<div class="row align-items-center" id="red" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.tokenForChange)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                @if (ExistAccessToken) {
                    <label style="color: white">
                        @_loc[nameof(RessourceAppStrings.entered)]
                    </label>
                }                
                else {
                    <label style="color: white">
                        @_loc[nameof(RessourceAppStrings.notRequested)]
                    </label>
                }
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                @if (ExistAccessToken) {
                    <button type="button" class="btn-danger" data-dismiss="modal" style="border-radius:8px" @onclick="() => ToastService.ShowToast(currentlyNotSupported, ToastLevel.Info)">
                        @_loc[nameof(RessourceAppStrings.change)]?
                    </button>
                }
                else {
                    <button type="button" class="btn-warning" data-dismiss="modal" style="border-radius:8px" @onclick="() => RequestAccessTokenForChanges()">
                        @_loc[nameof(RessourceAppStrings.request)]
                    </button>
                }
            </div>
        </div>
    </div>
</div>
@code { // only for the div row above
        string currentlyNotSupported = "Aktuell leider noch nicht verfügbar. Bitte beim Admin melden für Hilfestellungen!";
}

<div class="row align-items-center" id="red" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh; padding: 0.25vh;">
    <div class="col-lg-4">
        <label id="labelcolor">
            @_loc[nameof(RessourceAppStrings.emailAdminContact)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <div class="row">
            <div class="col-lg-6" align="right" style="margin-top: auto; margin-bottom: auto;">
                <input type="text" style="width: 50%;" @bind-value="AdminEmail">
            </div>
            <div class="col-lg-6" align="center" style="margin-top: auto; margin-bottom: auto;">
                <button type="button" class="btn-outline-success" data-dismiss="modal" style="border-radius:8px" @onclick="SendMessageToAdmin">
                    @_loc[nameof(RessourceAppStrings.notify)]
                </button>
            </div>
        </div>
    </div>
</div>
