@page "/settings"

@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject NavigationManager Navi
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JsRuntime
@inject ThemeService themeService

<PageTitle>@_loc[nameof(RessourceAppStrings.settings)]</PageTitle>

<h3>@_loc[nameof(RessourceAppStrings.settings)]</h3>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.language)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <CultureSelector />
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.colortheme)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <select @bind="@currentTheme">
            @foreach (var entity in themeList) {
                <option value="@entity.Key">@entity.Value</option>
            }
        </select>
        <button @onclick="() => saveUserThemePersistentAsync()">
            @_loc[nameof(RessourceAppStrings.savePermanent)]
        </button>
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.singleColumn)] (@_loc[nameof(RessourceAppStrings.currentlySelected)])
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="isSingleListWish">
        <label class="form-check-label" for="flexSwitchCheckChecked">@returnListWish</label>
    </div>
</div>

@code {
    ColorCode colorCode = 0;

    private bool isSingleListWish {
        get {
            return AppData.IsSingleListWishDashboard;
        }
        set {
            AppData.IsSingleListWishDashboard = value;
            WriteWishListToLocalStorage(value);
        }
    }

    private string returnListWish {
        get {
            if (AppData.IsSingleListWishDashboard) {
                return _loc[nameof(RessourceAppStrings.yes)];
            }
            else {
                return _loc[nameof(RessourceAppStrings.no)];
            }
        }
    }

    private void ChangeTheme(string value) {
        if (value.Equals("Dark")) {
            colorCode = ColorCode.Dark;
        }
        else if (value.Equals("Light")) {
            colorCode = ColorCode.Light;
        }
        themeService.ThemeCode = colorCode;
    }
    /// <summary> Set the current selection to the ThemeService. </summary>
    private string currentTheme {
        set => ChangeTheme(value);
        get {
            return themeService.ThemeCode.ToString();
        }
    }

    /// <summary> Hold the entities for theme-selection. </summary>
    private Dictionary<string, string> themeList = new Dictionary<string, string>() {
        { "Light", "Hell" },    
        { "Dark", "Dunkel" }   
    };

    /// <summary> Save the user-selection in the LocalStorage for remember by restart the PWA. </summary>
    private async void saveUserThemePersistentAsync() {
        try {
            await LocalStorage.SetItemAsStringAsync("UserTheme", currentTheme);
            await JsRuntime.InvokeVoidAsync("alert", string.Format("Farbschema {0} erfolgreich festgelegt.", currentTheme));
        }
        catch {
            await JsRuntime.InvokeVoidAsync("alert", "Fehler beim Speichern.");
        }
    }

    /// <summary>Save the Listform to localstorage persistant.</summary>
    /// <param name="value">new listwish bool</param>
    private async void WriteWishListToLocalStorage (bool value) {
        await LocalStorage.SetItemAsync<bool>("IsSingleWishListDashboard", value);
    }
}
