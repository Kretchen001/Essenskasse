@page "/settings"

@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject NavigationManager Navi
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient HttpClient
@inject IJSRuntime JsRuntime
@inject IConfiguration Config
@inject ThemeService themeService
@inject UserSettingsStore UserSettings
@inject ToastService ToastService

<PageTitle>@_loc[nameof(RessourceAppStrings.settings)]</PageTitle>

<div class="ek-dash ek-set-page">
    <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.settings)]</h2>

    <section class="ek-set ek-set-gray">
        <h3 class="ek-set-title">@_loc[nameof(RessourceAppStrings.settingsGeneral)]</h3>
        <div class="ek-set-row">
            <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.language)]</span></span>
            <span class="ek-set-control"><CultureSelector /></span>
        </div>
        <div class="ek-set-row">
            <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.colortheme)]</span></span>
            <span class="ek-set-control">
                <select class="ek-select" @bind="@CurrentTheme" aria-label="@_loc[nameof(RessourceAppStrings.colortheme)]">
                    @foreach (var entity in themeList) {
                        <option value="@entity.Key">@entity.Value</option>
                    }
                </select>
                <button type="button" class="ek-btn" @onclick="() => SaveUserThemePersistentAsync()">
                    @_loc[nameof(RessourceAppStrings.savePermanent)]
                </button>
            </span>
        </div>
    </section>

    <section class="ek-set ek-set-green">
        <h3 class="ek-set-title">@_loc[nameof(RessourceAppStrings.settingsDisplay)]</h3>
        <label class="ek-set-row">
            <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.singleColumn)]</span></span>
            <span class="ek-set-control">
                <span class="ek-switch">
                    <input type="checkbox" @bind="IsSingleListWish" />
                    <span class="ek-switch-track"></span>
                    <span>@ReturnListWish</span>
                </span>
            </span>
        </label>
        <label class="ek-set-row">
            <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.showNoticeablePersonRightDashboard)]</span></span>
            <span class="ek-set-control">
                <span class="ek-switch">
                    <input type="checkbox" @bind="NoticeableOnRightSide" />
                    <span class="ek-switch-track"></span>
                    <span>@ReturnNoticeableSide</span>
                </span>
            </span>
        </label>
        <AuthorizeView>
            <Authorized>
                <label class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.provider)]) @_loc[nameof(RessourceAppStrings.turnOn)]</span></span>
                    <span class="ek-set-control">
                        <span class="ek-switch">
                            <input type="checkbox" @bind="FilterShowProvider" />
                            <span class="ek-switch-track"></span>
                            <span>@FilterShowProviderString</span>
                        </span>
                    </span>
                </label>
                <label class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.person)]) @_loc[nameof(RessourceAppStrings.turnOn)]</span></span>
                    <span class="ek-set-control">
                        <span class="ek-switch">
                            <input type="checkbox" @bind="FilterShowPerson" />
                            <span class="ek-switch-track"></span>
                            <span>@FilterShowPersonString</span>
                        </span>
                    </span>
                </label>
            </Authorized>
        </AuthorizeView>
    </section>

    <AuthorizeView>
        <Authorized>
            <section class="ek-set ek-set-orange">
                <h3 class="ek-set-title">@_loc[nameof(RessourceAppStrings.settingsLists)]</h3>
                <label class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.paymentsToBeLoaded)]</span></span>
                    <span class="ek-set-control"><input type="number" min="1" max="500" class="ek-input ek-set-num" @bind="LoadAmountPayments" /></span>
                </label>
                <label class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.ordersToBeLoaded)]</span></span>
                    <span class="ek-set-control"><input type="number" min="1" max="500" class="ek-input ek-set-num" @bind="LoadAmountOrders" /></span>
                </label>
                <div class="ek-set-row">
                    <span class="ek-set-text">
                        <span class="ek-set-label">@_loc[nameof(RessourceAppStrings.settingsQuickAmounts)]</span>
                        <span class="ek-set-hint">@_loc[nameof(RessourceAppStrings.settingsQuickAmountsHint)]</span>
                    </span>
                    <span class="ek-set-control ek-set-quick">
                        <span class="ek-set-chips">
                            @foreach (long cents in QuickAmountList) {
                                <span class="ek-set-chip">
                                    <span>@Modells.QuickAmounts.Label(cents)</span>
                                    <button type="button" class="ek-set-chip-x" disabled="@(QuickAmountList.Count <= 1)"
                                            title="@_loc[nameof(RessourceAppStrings.quickAmountRemove)]"
                                            aria-label="@_loc[nameof(RessourceAppStrings.quickAmountRemove)]: @Modells.QuickAmounts.Label(cents)"
                                            @onclick="() => RemoveQuickAmount(cents)">✕</button>
                                </span>
                            }
                        </span>
                        <span class="ek-set-add">
                            <input type="text" inputmode="decimal" autocomplete="off" class="ek-input ek-set-num" placeholder="2,50"
                                   aria-label="@_loc[nameof(RessourceAppStrings.settingsQuickAmounts)]"
                                   @bind="newQuickAmount" @bind:event="oninput" @onkeydown="OnQuickAmountKeyDown" />
                            <button type="button" class="ek-btn" @onclick="AddQuickAmount">@_loc[nameof(RessourceAppStrings.quickAmountAdd)]</button>
                            <button type="button" class="ek-btn" @onclick="ResetQuickAmounts">@_loc[nameof(RessourceAppStrings.quickAmountReset)]</button>
                        </span>
                    </span>
                </div>
            </section>
        </Authorized>
    </AuthorizeView>

    <section class="ek-set ek-set-red">
        <h3 class="ek-set-title">@_loc[nameof(RessourceAppStrings.settingsCash)]</h3>
        <label class="ek-set-row">
            <span class="ek-set-text">
                <span class="ek-set-label">@_loc[nameof(RessourceAppStrings.limitValuePositivBalance)]</span>
                <span class="ek-set-hint">@_loc[nameof(RessourceAppStrings.current)]: @DashboardMoneyLimit.ToString()</span>
            </span>
            <span class="ek-set-control">
                <input type="text" inputmode="decimal" autocomplete="off" class="ek-input ek-set-num"
                       value="@LimitDisplay" @onchange="OnLimitChanged" />
            </span>
        </label>
        <AuthorizeView>
            <Authorized>
                <label class="ek-set-row">
                    <span class="ek-set-text">
                        <span class="ek-set-label">@_loc[nameof(RessourceAppStrings.confirmationMailSetting)]</span>
                    </span>
                    <span class="ek-set-control">
                        <select class="ek-select" @bind="SendConfirmationMail">
                            <option value="@Modells.User.ConfirmationMailMode.Never">@_loc[nameof(RessourceAppStrings.confirmationMailNever)]</option>
                            <option value="@Modells.User.ConfirmationMailMode.Optional">@_loc[nameof(RessourceAppStrings.confirmationMailOptional)]</option>
                            <option value="@Modells.User.ConfirmationMailMode.Always">@_loc[nameof(RessourceAppStrings.confirmationMailAlways)]</option>
                        </select>
                    </span>
                </label>
                <div class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.tokenForChange)]</span></span>
                    <span class="ek-set-control">
                        <span class="ek-set-status @(ExistAccessToken ? "is-ok" : "")">
                            @(ExistAccessToken ? _loc[nameof(RessourceAppStrings.entered)] : _loc[nameof(RessourceAppStrings.notRequested)])
                        </span>
                        @if (!ExistAccessToken) {
                            <button type="button" class="ek-btn" @onclick="() => RequestAccessTokenForChanges()">
                                @_loc[nameof(RessourceAppStrings.request)]
                            </button>
                        }
                    </span>
                </div>
                <div class="ek-set-row">
                    <span class="ek-set-text"><span class="ek-set-label">@_loc[nameof(RessourceAppStrings.emailAdminContact)]</span></span>
                    <span class="ek-set-control">
                        <input type="text" class="ek-input ek-set-wide" autocomplete="off" @bind-value="AdminEmail"
                               aria-label="@_loc[nameof(RessourceAppStrings.emailAdminContact)]" />
                        <button type="button" class="ek-btn" @onclick="SendMessageToAdmin">
                            @_loc[nameof(RessourceAppStrings.notify)]
                        </button>
                    </span>
                </div>
            </Authorized>
        </AuthorizeView>
    </section>

    <AuthorizeView>
        <Authorized>
            <section class="ek-set ek-set-gray">
                <h3 class="ek-set-title">@_loc[nameof(RessourceAppStrings.settingsServer)]</h3>
                <div class="ek-set-actions">
                    <button type="button" class="ek-btn" @onclick="() => RequestOnlineSettingsForThisUser()">
                        @_loc[nameof(RessourceAppStrings.requestSavedSettings)]
                    </button>
                    <button type="button" class="ek-btn" @onclick="() => SaveSettingsForThisUserOnline()">
                        @_loc[nameof(RessourceAppStrings.saveSettings)]
                    </button>
                </div>
            </section>
        </Authorized>
    </AuthorizeView>
</div>
