@page "/settings"

@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject NavigationManager Navi
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JsRuntime
@inject ThemeService themeService
@inject ToastService ToastService

<PageTitle>@_loc[nameof(RessourceAppStrings.settings)]</PageTitle>

<h3>@_loc[nameof(RessourceAppStrings.settings)]</h3>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.language)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <CultureSelector />
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.colortheme)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <select @bind="@CurrentTheme">
            @foreach (var entity in themeList) {
                <option value="@entity.Key">@entity.Value</option>
            }
        </select>
        <button @onclick="() => saveUserThemePersistentAsync()">
            @_loc[nameof(RessourceAppStrings.savePermanent)]
        </button>
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.singleColumn)] (@_loc[nameof(RessourceAppStrings.currentlySelected)])
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="IsSingleListWish">
        <label class="form-check-label" for="flexSwitchCheckChecked">@ReturnListWish</label>
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.paymentsToBeLoaded)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input type="number" @bind="LoadAmountPayments" />
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.ordersToBeLoaded)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input type="number" @bind="LoadAmountOrders" />
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.provider)]) @_loc[nameof(RessourceAppStrings.turnOn)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="FilterShowProvider">
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-4">
        <label>
            @_loc[nameof(RessourceAppStrings.filter)] (@_loc[nameof(RessourceAppStrings.person)]) @_loc[nameof(RessourceAppStrings.turnOn)]
        </label>
    </div>
    <div class="col-lg-8" align="center">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="FilterShowPerson">
    </div>
</div>

<div class="row align-items-center" style="border: 2px solid; border-color: lightslategray; margin-bottom: 0.5vh;">
    <div class="col-lg-6">
        <label>
            Grenzwert für Positives Saldo
        </label>
    </div>
    <div class="col-lg-2" align="center">
        <label>
            Aktuell: @DashboardMoneyLimit.ToString()
        </label>
    </div>
    <div class="col-lg-2" align="center">
        <input type="number" @bind="DashboardMoneyLimitInt">
    </div>
    <div class="col-lg-2">
    </div>
</div>
