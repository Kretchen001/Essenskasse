@page "/changeEntity"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject NavigationManager Nav

<PageTitle>@_loc[nameof(RessourceAppStrings.modifyEntity)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="row">
            <div class="col-lg-3">
                Zugriff verweigert!
            </div>
            <div class="col-lg-9">
                <button @onclick="() => Nav.NavigateTo(dashboardLink)">
                    Rückkehr zum Dashboard
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <h2>@_loc[nameof(RessourceAppStrings.modifyEntity)]</h2>
        <BlazorXTabs.XTabs>
            <BlazorXTabs.XTab Title="@_loc[nameof(RessourceAppStrings.payment)]">
                @foreach (int indexP in Enumerable.Range(0, Payments.Count)) {
                    <div class="row">
                        <ShowPaymentCard Payment="@Payments[indexP]"
                                         DesignationOfPerson="@GetTheDesignationOfPerson(Payments[indexP].ReferencedPerson)"
                                         PaymentNumberInList="indexP"
                                         ButtonChangeClickCallback="ShowPaymentChangeModal">
                        </ShowPaymentCard>
                    </div>
                }
                @if (Loaded) {
                    <HistoryModalCard @ref="@ModalDialogP" Title="Änderung Einzahlung">
                        <div class="row">
                            <div class="col-4"><b>@GetTheDesignationOfPerson(Payments[currentPaymentChangeIndex].ReferencedPerson)</b></div>
                            <div class="col-4">@Payments[currentPaymentChangeIndex].DateTime.ToString("dddd, dd. MMMM yyyy")</div>
                            <div class="col-4">@Payments[currentPaymentChangeIndex].Amount.ToString()</div>
                        </div>
                        <div class="row">
                            <div class="col-4"></div>
                            <div class="col-4"></div>
                            <div class="col-4">
                                <input style="width: 59%" type="number" @bind="newMoneyAmount" placeholder="Euro,Cent -> 1000 = 10,00€">
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-4">
                                Alter Kommentar
                            </div>
                            <div class="col-8">
                                @Uri.UnescapeDataString(Payments[currentPaymentChangeIndex].Comment)
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-4">
                                Neuer Kommentar
                            </div>
                            <div class="col-8">
                                <input type="text" @bind="@newComment" style="width: 81.15%"/>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <button class="btn btn-success" @onclick="() => ModalDialogP!.Close()">
                                @_loc[nameof(RessourceAppStrings.acceptChanges)]
                            </button>
                        </div>
                        <br />
                        <div class="row">
                            <button class="btn btn-primary" @onclick="() => ModalDialogP!.Close()">
                                @_loc[nameof(RessourceAppStrings.close)]
                            </button>
                        </div>
                    </HistoryModalCard>
                }
            </BlazorXTabs.XTab>
            <BlazorXTabs.XTab Title="@_loc[nameof(RessourceAppStrings.order)]">
                @foreach (int indexO in Enumerable.Range(0, Orders.Count)) {
                    <div class="row">
                        <ShowOrderCard Order="@Orders[indexO]"
                                        DesignationOfPerson="@GetTheDesignationOfPerson(Orders[indexO].ReferencedPerson)"
                                        OrderNumberInList="indexO"
                                        ButtonChangeClickCallback="ShowOrderChangeModal">
                        </ShowOrderCard>
                    </div>
                }
                @if (Loaded) {
                    <HistoryModalCard @ref="@ModalDialogO" Title="Änderung Bestellung">
                        <div class="row">
                            <div class="col-4">@GetTheDesignationOfPerson(Orders[currentOrderChangeIndex].ReferencedPerson)</div>
                            <div class="col-4">@Orders[currentOrderChangeIndex].DateTime.ToString("dddd, dd. MMMM yyyy")</div>
                            <div class="col-4">@Orders[currentOrderChangeIndex].Money.ToString()</div>
                        </div>
                        <div class="row">
                            <div class="col-4"></div>
                            <div class="col-4"></div>
                            <div class="col-4">
                                <input style="width: 59%" type="number" @bind="newMoneyAmount" placeholder="Euro,Cent -> 1000 = 10,00€">
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-3">
                                Alter Anbieter
                            </div>
                            <div class="col-9">
                                @Orders[currentOrderChangeIndex].Provider.Designation
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-3">
                                Neuer Anbieter
                            </div>
                            <select class="form-select" style="margin: 0.2rem;" value="@Orders[currentOrderChangeIndex].Provider.Guid" @onchange="(e) => {newSelectedProvider = Providers.First(x => x.Guid.Equals(new Guid(e.Value!.ToString()!))).Guid;}">
                                @foreach (Provider z in Providers) {
                                    <option value="@z.Guid">@z.Designation</option>
                                }
                            </select>
                        </div>
                        <br />
                        <div class="row">
                            <button class="btn btn-success" @onclick="() => ModalDialogO!.Close()">
                                @_loc[nameof(RessourceAppStrings.acceptChanges)]
                            </button>
                        </div>
                        <br />
                        <div class="row">
                            <button class="btn btn-primary" @onclick="() => ModalDialogO!.Close()">
                                @_loc[nameof(RessourceAppStrings.close)]
                            </button>
                        </div>
                    </HistoryModalCard>
                }
            </BlazorXTabs.XTab>
        </BlazorXTabs.XTabs>
    </Authorized>
</AuthorizeView>

@code {
    string dashboardLink = "/";
}
