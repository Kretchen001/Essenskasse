@page "/changeEntity"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService

<PageTitle>Ändere Einträge</PageTitle>

<h2>Einträge ändern</h2>

<div class="row" style="height: fit-content; margin-bottom: 1rem;">
    <div class="col-lg-3 align-self-center">
        <label>
            Typ
        </label>
    </div>
    <div class="col-lg-9">
        <select class="form-select" @bind="@selectedType">
            @foreach (string x in types) {
                <option value="@x">@x</option>
            }
        </select>
    </div>
</div>

@if (selectedType == types[0]) { // Einzahlungen/Payments
    @foreach(int indexP in Enumerable.Range(0, payments.Count)) {
        <div class="row" style="border: 2px dotted gray; margin: 2px">
            <div class="col-lg-3">
                @getTheDesignationOfPerson(payments[indexP].ReferencedPerson)
            </div>
            <div class="col-lg-4">
                @payments[indexP].DateTime.ToString("dddd, dd MMMM yyyy")
            </div>
            <div class="col-lg-3">
                @payments[indexP].Amount.ToString()
            </div>
            <div class="col-lg-2">
            </div>
            <br />
            <div class="col-lg-3">
                @getTheDesignationOfPerson(payments[indexP].ReferencedPerson)
            </div>
            <div class="col-lg-4">
                <label>
                    Datum nicht änderbar!
                </label>
            </div>
            <div class="col-lg-3">
                <input style="width: 25vw" type="number" @bind="paymentAmount[indexP]" placeholder="Euro,Cent -> 1000 = 10,00€">
            </div>
            <div class="col-lg-2">
                <button @onclick="() => commitChangesP(indexP)">
                    Absenden
                </button>
            </div>
        </div>
    }
}
else if (selectedType == types[1]) { // Bestellungen/Orders
    @foreach (int indexO in Enumerable.Range(0, orders.Count)) {
        <div class="row" style="border: 2px dotted gray; margin: 2px">
            <div class="col-lg-3">
                @getTheDesignationOfPerson(orders[indexO].ReferencedPerson)
            </div>
            <div class="col-lg-3">
                @orders[indexO].DateTime.ToString("dddd, dd MMMM yyyy")
            </div>
            <div class="col-lg-2">
                @orders[indexO].Money.ToString()
            </div>
            <div class="col-lg-2">
                @orders[indexO].Provider.Designation
            </div>
            <br />
            <div class="col-lg-3">
                <select class="form-select" @bind="@changedOrders[indexO].ReferencedPerson">
                    @foreach (Person x in person) {
                        Console.WriteLine(x.Name);
                        <option value="@x.Guid">@x.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-3">
                <label>
                    Datum nicht änderbar!
                </label>
            </div>
            <div class="col-lg-2">
                <input style="width: 25vw" type="number" @bind="orderAmount[indexO]" placeholder="Euro,Cent -> 1000 = 10,00€">
            </div>
            <div class="col-lg-2">
                <select class="form-select" @bind="@changedOrders[indexO].Provider">
                    @foreach (Provider y in provider) {
                        Console.WriteLine(y.Designation);
                        <option value="@y">@y.Designation</option>
                    }
                </select>
            </div>
        </div>
    }
}

@code {
    List<string> types = ["Einzahlungen", "Bestellungen"];
    string selectedType = string.Empty;

    List<Person> person { get; set; } = [];
    List<Provider> provider { get; set; } = [];
    List<Payment> payments { get; set; } = [];
    List<Order> orders { get; set; } = [];

    List<Payment> changedPayments { get; set; } = [];
    List<int> paymentAmount { get; set; } = [];

    List<Order> changedOrders { get; set; } = [];
    List<int> orderAmount { get; set; } = [];

    protected override async Task OnInitializedAsync() {
        await requestPerson();
        await requestProvider();
        await requestPayments();
        await requestOrders();
        selectedType = types[0];
        base.StateHasChanged();
    }

    private async Task requestPerson() {
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "person/requestAll")
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            person = JsonConvert.DeserializeObject<List<Person>>(await response.Content.ReadAsStringAsync()) ?? new List<Person>();
            person.ForEach(x => x.Name = Uri.UnescapeDataString(x.Name));
            person.ForEach(x => x.Email = Uri.UnescapeDataString(x.Email));
            person = person.OrderBy(x => x.Name).ToList();
        }
        else {
            ToastService.ShowToast(_loc[nameof(RessourceAppStrings.toastNoApiConnection)], ToastLevel.Warning);
        }
    }

    private async Task requestProvider() {
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "provider/requestAll")
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) { // success?
                                            // deserialize the result-JSON with Newtownsoft to the List
            provider = JsonConvert.DeserializeObject<List<Provider>>(await response.Content.ReadAsStringAsync()) ?? new List<Provider>();
            provider.ForEach(x => x.Designation = Uri.UnescapeDataString(x.Designation));
            provider = provider.OrderBy(x => x.Designation).ToList();
        }
        else {
            ToastService.ShowToast(_loc[nameof(RessourceAppStrings.toastNoApiConnection)], ToastLevel.Warning);
        }
    }

    private async Task requestPayments() {
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "payment/requestAmount"),
                Headers = {
                    { "amount", AppData.LoadAmountPayment.ToString() }
                }
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            payments = JsonConvert.DeserializeObject<List<Payment>>(await response.Content.ReadAsStringAsync()) ?? new List<Payment>();
            changedPayments = JsonConvert.DeserializeObject<List<Payment>>(await response.Content.ReadAsStringAsync()) ?? new List<Payment>();
            payments.ForEach(x => paymentAmount.Add(0));
        }
        else {
            ToastService.ShowToast(_loc[nameof(RessourceAppStrings.toastSomethingWrong)], ToastLevel.Warning);
        }
    }

    private async Task requestOrders() {
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "order/requestAmount"),
                Headers = {
                    { "amount", AppData.LoadAmountPayment.ToString() }
                }
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            orders = JsonConvert.DeserializeObject<List<Order>>(await response.Content.ReadAsStringAsync()) ?? new List<Order>();
            changedOrders = JsonConvert.DeserializeObject<List<Order>>(await response.Content.ReadAsStringAsync()) ?? new List<Order>();
        }
        else {
            ToastService.ShowToast(_loc[nameof(RessourceAppStrings.toastSomethingWrong)], ToastLevel.Warning);
        }
    }

    private string getTheDesignationOfPerson(Guid guid) {
        foreach(Person x in person) {
            if (x.Guid.Equals(guid)) {
                return x.Name;
            }
        }
        return "";
    }

    private async Task commitChangesP(int index) {
        short cent = (short) (paymentAmount[index] % 100);
        long euro = (long) ((paymentAmount[index] - cent) * 0.01);
        changedPayments[index].Amount = new Money(euro, cent);
        if (payments[index].Amount.Equals(changedPayments[index].Amount) &&
            payments[index].DateTime.Equals(changedPayments[index].DateTime)) {
            ToastService.ShowToast("Keine Änderungen detektiert!", ToastLevel.Info);
            return;
        }
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Put,
                RequestUri = new Uri(Config["API-Adress"] + "payment/update"),
                Headers = {
                    { "accessToken", AppData.AccessToken.ToString() },
                    { "dateString", changedPayments[index].DateTime.Ticks.ToString() }
                },
                Content = new StringContent(JsonConvert.SerializeObject(changedPayments[index].Amount), Encoding.UTF8, "application/json")
            };

        var response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            ToastService.ShowToast("Update erfolgreich", ToastLevel.Success);
            payments[index] = new Payment() {
                ReferencedPerson = payments[index].ReferencedPerson,
                DateTime = changedPayments[index].DateTime,
                Amount = changedPayments[index].Amount
            };
            base.StateHasChanged();
            return;
        }
        else {
            ToastService.ShowToast(_loc[nameof(RessourceAppStrings.toastAdminCall)], ToastLevel.Warning);
        }
    }
}
