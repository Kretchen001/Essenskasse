@page "/changeEntity"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject NavigationManager Nav
@inject AuthStateService AuthState

<PageTitle>@_loc[nameof(RessourceAppStrings.modifyEntity)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash ek-chg">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.modifyEntity)]</h2>

            <div class="ek-seg ek-seg-neutral ek-chg-tabs" role="group" aria-label="@_loc[nameof(RessourceAppStrings.changeTabsLabel)]">
                <button type="button" class="@(showOrders ? "" : "is-active")" aria-pressed="@((!showOrders).ToString().ToLowerInvariant())" @onclick="() => ShowOrders(false)">
                    @_loc[nameof(RessourceAppStrings.payment)]
                </button>
                <button type="button" class="@(showOrders ? "is-active" : "")" aria-pressed="@showOrders.ToString().ToLowerInvariant()" @onclick="() => ShowOrders(true)">
                    @_loc[nameof(RessourceAppStrings.order)]
                </button>
            </div>

            @if (loading) {
                <ul class="ek-hist" aria-busy="true" aria-live="polite">
                    @for (int i = 0; i < 5; i++) {
                        <li class="ek-skeleton" aria-hidden="true"><span class="ek-skeleton-line"></span></li>
                    }
                </ul>
            }
            else if (!showOrders) {
                @if (Payments.Count == 0) {
                    <div class="ek-empty">
                        <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noPaymentsYet)]</p>
                    </div>
                }
                else {
                    @foreach (IGrouping<DateTime, Payment> month in PaymentsByMonth) {
                        <h3 class="ek-hist-month">@month.Key.ToString("MMMM yyyy")</h3>
                        <ul class="ek-hist">
                            @foreach (Payment x in month) {
                                <li class="@(x.Amount.IsPositiv() ? "" : "is-negative")">
                                    <span class="ek-hist-date">@x.DateTime.ToString("ddd, dd.MM. HH:mm")</span>
                                    <span class="ek-chg-main">
                                        <span class="ek-chg-person">@PersonName(x.ReferencedPerson)</span>
                                        @if (!string.IsNullOrWhiteSpace(x.Comment)) {
                                            <span class="ek-chg-sub">@x.Comment</span>
                                        }
                                    </span>
                                    <span class="ek-hist-amount">@x.Amount.ToString()</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="ek-hist-more">
                        @if (noMorePayments) {
                            <span class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.endOfList)]</span>
                        }
                        else {
                            <button type="button" class="ek-btn" disabled="@loadingMore" @onclick="LoadNextAmountOfPayments">
                                @_loc[nameof(RessourceAppStrings.buttonLoadMore)]
                            </button>
                        }
                    </div>
                }
            }
            else {
                @if (Orders.Count == 0) {
                    <div class="ek-empty">
                        <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.orderNoOrdersYet)]</p>
                    </div>
                }
                else {
                    @foreach (IGrouping<DateTime, Order> month in OrdersByMonth) {
                        <h3 class="ek-hist-month">@month.Key.ToString("MMMM yyyy")</h3>
                        <ul class="ek-hist">
                            @foreach (Order x in month) {
                                <li>
                                    <span class="ek-hist-date">@x.DateTime.ToString("ddd, dd.MM. HH:mm")</span>
                                    <span class="ek-chg-main">
                                        <span class="ek-chg-person">@PersonName(x.ReferencedPerson)</span>
                                        <span class="ek-chg-sub">@x.Provider.Designation</span>
                                    </span>
                                    <span class="ek-hist-amount">@x.Money.ToString()</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="ek-hist-more">
                        @if (noMoreOrders) {
                            <span class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.endOfList)]</span>
                        }
                        else {
                            <button type="button" class="ek-btn" disabled="@loadingMore" @onclick="LoadNextAmountOfOrders">
                                @_loc[nameof(RessourceAppStrings.buttonLoadMore)]
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </Authorized>
</AuthorizeView>
