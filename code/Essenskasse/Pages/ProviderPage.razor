@page "/provider"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject ILocalStorageService LocalStorage
@inject UserSettingsStore UserSettings
@inject NavigationManager Nav
@inject AuthStateService AuthState

<PageTitle>@_loc[nameof(RessourceAppStrings.provider)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash ek-pg-provider">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.provider)]</h2>

            <form class="ek-add" @onsubmit="AddNewProvider" @onsubmit:preventDefault>
                <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.addNewProvider)]</h3>
                <div class="ek-add-fields ek-add-single">
                    <label class="ek-field">
                        <span>@_loc[nameof(RessourceAppStrings.designator)]</span>
                        <input @ref="newNameInput" type="text" class="ek-input" autocomplete="off"
                               @bind="newProviderDesignation" @bind:event="oninput" />
                    </label>
                    <button type="submit" class="ek-btn ek-btn-primary ek-add-submit" disabled="@(!CanAdd)">
                        @(NewNameDuplicate ? _loc[nameof(RessourceAppStrings.addAnyway)] : _loc[nameof(RessourceAppStrings.add)])
                    </button>
                </div>
                @if (NewNameDuplicate) {
                    <p class="ek-hint is-warn">@_loc[nameof(RessourceAppStrings.duplicateProvider)]</p>
                }
            </form>

            <h3 class="ek-group-title ek-list-title">@_loc[nameof(RessourceAppStrings.providerRegistered)]</h3>
            @if (AppData.FilterShowProvider) {
                <div class="ek-search">
                    <svg class="ek-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    <input id="ek-person-search" type="text" inputmode="search" class="ek-search-input" autocomplete="off"
                           placeholder="@_loc[nameof(RessourceAppStrings.searchProviders)]"
                           aria-label="@_loc[nameof(RessourceAppStrings.searchProviders)]"
                           @bind="Filter" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                    @if (Filter.Length == 0) {
                        <kbd class="ek-kbd" aria-hidden="true">/</kbd>
                    }
                    else {
                        <span class="ek-search-count">@_loc[nameof(RessourceAppStrings.shownOfTotal), shownProviderList.Count, providers.Count]</span>
                        <button type="button" class="ek-icon-btn" @onclick="ClearFilter"
                                title="@_loc[nameof(RessourceAppStrings.clearSearch)]"
                                aria-label="@_loc[nameof(RessourceAppStrings.clearSearch)]">✕</button>
                    }
                </div>
            }
            <div class="ek-people-tools">
                <label class="ek-select-wrap">
                    <span>@_loc[nameof(RessourceAppStrings.sortBy)]</span>
                    <select class="ek-select" @bind="SortKey">
                        <option value="@nameof(ProviderSort.NameAsc)">@_loc[nameof(RessourceAppStrings.sortNameAsc)]</option>
                        <option value="@nameof(ProviderSort.NameDesc)">@_loc[nameof(RessourceAppStrings.sortNameDesc)]</option>
                        <option value="@nameof(ProviderSort.LastOrderedFirst)">@_loc[nameof(RessourceAppStrings.sortLastOrdered)]</option>
                        <option value="@nameof(ProviderSort.MostOrdersFirst)">@_loc[nameof(RessourceAppStrings.sortMostOrders)]</option>
                    </select>
                </label>
            </div>
            @if (isLoading) {
                <div class="ek-grid ek-people" aria-busy="true" aria-live="polite">
                    @for (int i = 0; i < 6; i++) {
                        <div class="ek-person ek-skeleton" aria-hidden="true">
                            <span class="ek-avatar"></span>
                            <div class="ek-person-text">
                                <span class="ek-skeleton-line"></span>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (loadFailed) {
                <div class="ek-empty" role="alert">
                    <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.providerLoadFailed)]</p>
                    <button type="button" class="ek-btn ek-btn-primary" @onclick="RequestAllProviderFromApiAsync">@_loc[nameof(RessourceAppStrings.retry)]</button>
                </div>
            }
            else if (providers.Count == 0) {
                <div class="ek-empty">
                    <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noProvidersYet)]</p>
                    <p class="ek-empty-text">@_loc[nameof(RessourceAppStrings.noProvidersYetHint)]</p>
                </div>
            }
            else if (shownProviderList.Count == 0) {
                <div class="ek-empty">
                    <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noMatches)]</p>
                    <button type="button" class="ek-btn" @onclick="ClearFilter">@_loc[nameof(RessourceAppStrings.resetFilter)]</button>
                </div>
            }
            else {
                <div class="ek-grid ek-people">
                    @foreach (Provider x in shownProviderList) {
                        <ProviderListCard Provider="x" Statistics="StatisticsOf(x)" OnUpdated="OnProviderUpdated" OnRemoved="OnProviderRemoved" />
                    }
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>
