@page "/provider"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc

<style>
    table, th, td {
        border:1px solid gray;
    }
    /* Width of the rows */
    th:nth-child(1), td:nth-child(1) {
        width: 33% !important; /* first row 33% of the table*/
    }

    th:nth-child(2), td:nth-child(2) {
        width: 67% !important; /* secound row 67% of the table*/
    }
</style>

<PageTitle>@_loc[nameof(RessourceAppStrings.provider)]</PageTitle>

<h2>@_loc[nameof(RessourceAppStrings.provider)]</h2>
<div class="row">
    <h4 style="margin-top: 1rem;">
        @_loc[nameof(RessourceAppStrings.available)]
    </h4>
    <div class="col-lg-12">
        <table style="margin-left: 1rem; margin-right: 1rem; width: calc(100% - 2rem);">
            <tr>
                <th style="padding-left: 5px;">Guid</th>
                <th style="padding-left: 5px;">Bezeichnung</th>
            </tr>
            @foreach(Provider x in providers) {
                <tr>
                    <td style="padding-left: 5px;">@x.Guid</td>
                    <td style="padding-left: 5px;">@x.Designation</td>
                </tr>
            }
        </table>
    </div>
</div>

@code {
    List<Provider> providers = new List<Provider>();

    protected override async Task OnInitializedAsync() {
        // Request all providers, that are saved in the database.
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "api/provider/requestAll")
            };

        try {
            HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

            if (response.IsSuccessStatusCode) { // success?
                                                // deserialize the result-JSON with Newtownsoft to the List
                providers = JsonConvert.DeserializeObject<List<Provider>>(await response.Content.ReadAsStringAsync()) ?? new List<Provider>();
            }
        }
        catch {
            await JSRuntime.InvokeVoidAsync("alert", "Keine API Verbindung möglich!");
        }
    }
                return;
