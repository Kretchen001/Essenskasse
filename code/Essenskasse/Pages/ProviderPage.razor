@page "/provider"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc

<style>
    table, th, td {
        border: 1px solid gray;
    }

    /* Width of the rows */
    th:nth-child(1), td:nth-child(1) {
        width: 33% !important; /* first row 33% of the table*/
    }

    th:nth-child(2), td:nth-child(2) {
        width: 67% !important; /* secound row 67% of the table*/
    }
</style>

<PageTitle>@_loc[nameof(RessourceAppStrings.provider)]</PageTitle>

<h2>@_loc[nameof(RessourceAppStrings.provider)]</h2>
<div class="row">
    <h4 style="margin-top: 1rem;">
        @_loc[nameof(RessourceAppStrings.add)]
    </h4>
    @if (!accessToAdd) {
        <button style="width: fit-content;"
                @onclick="() => {accessToAdd = true;}">
            @_loc[nameof(RessourceAppStrings.addNewProvider)]
        </button>
    }
    else {
        <div class="col-lg-2">
            <label style="vertical-align: middle;">
                @_loc[nameof(RessourceAppStrings.add)]
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" name="nameHinzuzufuegen" id="idHinzuzufuegen"
                   style="width: 100%;" @bind-value="newProviderDesignation">
        </div>
        <div class="col-lg-2">
            <button @onclick="() => addNewAnbieter()">
                @_loc[nameof(RessourceAppStrings.submit)]
            </button>
        </div>
    }
</div>
<br />
<div class="row">
    <h4 style="margin-top: 1rem;">
        @_loc[nameof(RessourceAppStrings.available)]
    </h4>
    <div class="col-lg-12">
        <table style="margin-left: 1rem; margin-right: 1rem; width: calc(100% - 2rem);">
            <tr>
                <th style="padding-left: 5px;">Guid</th>
                <th style="padding-left: 5px;">Bezeichnung</th>
            </tr>
            @foreach (Provider x in providers) {
                <tr>
                    <td style="padding-left: 5px;">@x.Guid</td>
                    <td style="padding-left: 5px;">@x.Designation</td>
                </tr>
            }
        </table>
    </div>
</div>
<br />
<div class="row">
    <h4 style="margin-top: 1rem;">
        Entfernen eines Eintrages
    </h4>
    @if (!accessToDelete) {
        <button style="width: fit-content;"
                @onclick="() => {accessToDelete = true;}">
            Anbieter entfernen?
        </button>
    }
    else {
        <div class="col-lg-2">
            <label style="vertical-align: middle;">
                Guid des zu entfernenden Anbieters
            </label>
        </div>
        <div class="col-lg-8">
            <input type="text" name="nameHinzuzufuegen" id="idHinzuzufuegen"
                   style="width: 100%; vertical-align: middle;"
                   @bind-value="providerToDeleteGuid">
        </div>
        <div class="col-lg-2" style="vertical-align: middle;">
            <button @onclick="() => deleteAnbieter()">
                Löschen!
            </button>
        </div>
    }
</div>

@code {
    private bool accessToAdd = false;
    private bool accessToDelete = false;

    private string newProviderDesignation = "";
    private string providerToDeleteGuid = "";

    List<Provider> providers = new List<Provider>();

    protected override async Task OnInitializedAsync() {
        // Request all providers, that are saved in the database.
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "provider/requestAll")
            };

        try {
            HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

            if (response.IsSuccessStatusCode) { // success?
                                                // deserialize the result-JSON with Newtownsoft to the List
                providers = JsonConvert.DeserializeObject<List<Provider>>(await response.Content.ReadAsStringAsync()) ?? new List<Provider>();
                providers.ForEach(x => x.Designation = Uri.UnescapeDataString(x.Designation));
            }
        }
        catch {
            await JSRuntime.InvokeVoidAsync("alert", "Keine API Verbindung möglich!");
        }
    }

    private async void addNewAnbieter() {
        if (newProviderDesignation.Equals("")) {
            return;
        }
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Post,
                RequestUri = new Uri(Config["API-Adress"] + "provider/new"),
                Headers = {
                        {"name", Uri.EscapeDataString(newProviderDesignation)}
                    }
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            string temp = await response.Content.ReadAsStringAsync();
            providers.Add(new Provider(new Guid(temp[1..(temp.Length - 1)]), newProviderDesignation));
            await JSRuntime.InvokeVoidAsync("alert", "Anbieter " + newProviderDesignation + " hinzugefügt");
        }

        newProviderDesignation = "";
        accessToAdd = false;
        base.StateHasChanged();
    }

    private async Task deleteAnbieter() {
        Provider? tempAnbieter = providers.Find(x => x.Guid.Equals(new Guid(providerToDeleteGuid)));
        if (tempAnbieter is null) {
            await JSRuntime.InvokeVoidAsync("alert", "Guid nicht vergeben!");
            return;
        }
        if (await JSRuntime.InvokeAsync<bool>(
                            "confirm",
                            "Wollen sie den Anbieter - " +
                            tempAnbieter.Designation +
                            " - wirklich löschen?")) {
            // Bestätigt, also lösche
            HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                    Method = HttpMethod.Delete,
                    RequestUri = new Uri(Config["API-Adress"] + "provider/remove"),
                    Headers = {
                        {"guid", providerToDeleteGuid}
                    }
                };

            var response = await HttpClient.SendAsync(httpRequestMessage);

            if (response.IsSuccessStatusCode) {
                Provider temp = JsonConvert.DeserializeObject<Provider>(await response.Content.ReadAsStringAsync())!;
                await JSRuntime.InvokeVoidAsync("alert", "Person " + temp.Designation + " erfolgreich entfernt!");
                providers.Remove(tempAnbieter);
                accessToDelete = false;
                providerToDeleteGuid = "";
                base.StateHasChanged();
                return;
            }
            await JSRuntime.InvokeVoidAsync("alert", "Hat nicht geklappt!");
        }
    }
}