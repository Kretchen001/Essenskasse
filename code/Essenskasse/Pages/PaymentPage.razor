@page "/payment"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData

<PageTitle>@_loc[nameof(RessourceAppStrings.payment)]</PageTitle>

<h2>@_loc[nameof(RessourceAppStrings.payment)]</h2>

<div class="row">
    <div class="col-lg-3 align-self-center">
        <label>
            @_loc[nameof(RessourceAppStrings.person)]
        </label>
    </div>
    <div class="col-lg-9">
        <select class="form-select" @bind="@selectedPerson">
            @if (person is not null) {
                @foreach (var x in person) {
                    <option value="@x.Guid">@x.Name</option>
                }
            }
        </select>
    </div>
</div>
<br />
<div class="row">
    <div class="col-lg-3 align-self-center">
        <label>
            @_loc[nameof(RessourceAppStrings.amount)]
        </label>
    </div>
    <div class="col-lg-4 align-self-center">
        <input style="width: 25vw" type="number" @bind="payment" placeholder="Euro,Cent -> 1000 = 10,00€">
    </div>
    <div class="col-lg-5 align-self-center">
        <label>
            @money.ToString()
        </label>
    </div>
</div>
<br />
<div class="row">
    <button @onclick="() => insertPayment()">
        @_loc[nameof(RessourceAppStrings.creditAmount)]
    </button>
</div>
<br />
<hr />
<br />
<div class="row">
    <div class="col-lg-12">
        <table style="margin-left: 1rem; margin-right: 1rem; width: calc(100% - 2rem);">
            <tr>
                <th>@_loc[nameof(RessourceAppStrings.date)]</th>
                <th>@_loc[nameof(RessourceAppStrings.amount)]</th>
            </tr>
            @for (int i = 0; i < paymentsOfSelectedPerson.Count; i += 1) {
                @if (i % 3 == 0) {
                    <tr>
                        <td>@paymentsOfSelectedPerson[i].DateTime.ToString("dddd, dd MMMM yyyy (HH:mm)")</td>
                        <td>@paymentsOfSelectedPerson[i].Amount</td>
                    </tr>
                }
                else if (i % 3 == 1) {
                    <tr style="background-color: lightgray">
                        <td>@paymentsOfSelectedPerson[i].DateTime.ToString("dddd, dd MMMM yyyy (HH:mm)")</td>
                        <td>@paymentsOfSelectedPerson[i].Amount</td>
                    </tr>
                }
                else if (i % 3 == 2) {
                    <tr style="background-color: grey">
                        <td>@paymentsOfSelectedPerson[i].DateTime.ToString("dddd, dd MMMM yyyy (HH:mm)")</td>
                        <td>@paymentsOfSelectedPerson[i].Amount</td>
                    </tr>
                }
            }
        </table>
    </div>
</div>

@code {

    private List<Person>? person = new List<Person>();
    private Guid _selectedPerson;
    private Guid selectedPerson {
        get {
            return _selectedPerson;
        }
        set {
            _selectedPerson = value;
            requestPaymentsOfPerson();
        }
    }

    private int payment = 0;
    private Money money {
        get {
            short cent = (short)(payment % 100);
            long euro = (long)((payment - cent) * 0.01);
            return new Money(euro, cent);
        }
    }

    private List<Payment> paymentsOfSelectedPerson = new List<Payment>();
    private int amount {
        get => AppData.LoadAmountPayment;
    }

    protected override async Task OnInitializedAsync () {
        await refreshPersonList();
    }

    private async Task refreshPersonList () {
        // Request all Person, that are saved in the database
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "person/requestAll")
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            person = JsonConvert.DeserializeObject<List<Person>>(await response.Content.ReadAsStringAsync()) ?? new List<Person>();
            person.ForEach(x => x.Name = Uri.UnescapeDataString(x.Name));
            person.ForEach(x => x.Email = Uri.UnescapeDataString(x.Email));
            person = person.OrderBy(x => x.Name).ToList();

            if (person.Count > 0) {
                selectedPerson = person[0].Guid;
            }
        }
    }

    private async void requestPaymentsOfPerson () {
        // Request last 10 payments of a person
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "payment/fromPerson"),
                Headers = {
                    { "guid", selectedPerson.ToString() },
                    { "amount", amount.ToString() }
                }
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            paymentsOfSelectedPerson = JsonConvert.DeserializeObject<List<Payment>>(await response.Content.ReadAsStringAsync()) ?? new List<Payment>();
        }

        base.StateHasChanged();
    }

    private async void insertPayment () {
        if (!(await JSRuntime.InvokeAsync<bool>("confirm", "Folgenden Betrag eintragen?\n" + money.ToString()))) {
            return;
        }

        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Post,
                RequestUri = new Uri(Config["API-Adress"] + "payment/insertNew"),
                Headers = {
                    {"referencedPerson", selectedPerson.ToString()}
                },
                Content = new StringContent(JsonConvert.SerializeObject(money), Encoding.UTF8, "application/json")
            };

        var response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            await JSRuntime.InvokeVoidAsync("alert", "Hat geklappt");
            paymentsOfSelectedPerson.Add(JsonConvert.DeserializeObject<Payment>(await response.Content.ReadAsStringAsync())!);
            base.StateHasChanged();
            return;
        }
        await JSRuntime.InvokeVoidAsync("alert", "Hat nicht geklappt!");
    }
}