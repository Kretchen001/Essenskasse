@page "/"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<button @onclick="RecalculateSaldos">
    Saldo neu berechnen lassen
</button>

@code {

    private async void RecalculateSaldos() {
        // Request all providers, that are saved in the database.
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "person/updateDatabasePersonSaldo")
            };

        try {
            HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

            if (response.IsSuccessStatusCode) {
                await JSRuntime.InvokeVoidAsync("alert", "Erfolg\nAber muss noch implementiert werden.");
            }
        }
        catch {
            await JSRuntime.InvokeVoidAsync("alert", "Keine API Verbindung möglich!");
        }
    }
}