@page "/"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ILocalStorageService LocalStorage
@inject AppDataService AppData
@inject ToastService ToastService

<PageTitle>@_loc[nameof(RessourceAppStrings.dashboard)]</PageTitle>

<div class="row">
    <div class="col-lg-4">
        <h2>@_loc[nameof(RessourceAppStrings.dashboard)]</h2>
    </div>
    <div class="col-lg-8 align-self-lg-center">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" @bind="IsSingleListWish">
            <label class="form-check-label" for="flexSwitchCheckChecked">@_loc[nameof(RessourceAppStrings.singleColumn)] = @ReturnListWish</label>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-lg-3 align-self-lg-center">
        <h3>Kassenstand (Ist)</h3>
    </div>
    <div class="col-lg-9 align-self-lg-center">
        <h3>@currentCashBalance.ToString()</h3>
    </div>
</div>
<hr />
@if (IsSingleListWish) {
    <div class="row">
        <div class="col-lg-12">
            @for (int i = 0; i < person.Count; i += 1) {
                @if (positivSaldo.Contains(i)) {
                    <ShowPersonCard Person="person[i]" PositivSaldo="true" />
                }
                else {
                    <ShowPersonCard Person="person[i]" PositivSaldo="false" />
                }
            }
        </div>
    </div>
}
else {
    <div class="row">
        <div class="col-lg-6">
            <h3><u>@_loc[nameof(RessourceAppStrings.inconspicuous)]</u></h3>
            @for (int i = 0; i < person.Count; i += 1) {
                @if (positivSaldo.Contains(i)) {
                    <ShowPersonCard Person="person[i]" PositivSaldo="true" />
                }
            }
        </div>
        <div class="col-lg-6">
            <h3><u>@_loc[nameof(RessourceAppStrings.noticeable)]</u></h3>
            @for (int i = 0; i < person.Count; i += 1) {
                @if (!positivSaldo.Contains(i)) {
                    <ShowPersonCard Person="person[i]" PositivSaldo="false" />
                }
            }
        </div>
    </div>
}

<button @onclick="RecalculateSaldos">
    @_loc[nameof(RessourceAppStrings.recalculateSaldo)]
</button>
