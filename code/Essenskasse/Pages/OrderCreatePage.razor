@page "/orderCreate"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>@_loc[nameof(RessourceAppStrings.createNewOrder)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash ek-ord-page">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.createNewOrder)]</h2>

            <div class="ek-seg ek-seg-neutral ek-ord-tabs" role="tablist">
                <button type="button" role="tab" class="@(view == OrderView.Order ? "is-active" : "")" aria-selected="@(view == OrderView.Order)"
                        @onclick="() => ShowView(OrderView.Order)">@_loc[nameof(RessourceAppStrings.orderTabOrder)]</button>
                <button type="button" role="tab" class="@(view == OrderView.Overview ? "is-active" : "")" aria-selected="@(view == OrderView.Overview)"
                        @onclick="() => ShowView(OrderView.Overview)">@_loc[nameof(RessourceAppStrings.overview)]</button>
            </div>

            @if (view == OrderView.Order) {
                <div class="ek-add ek-ord-head">
                    <div class="ek-field ek-ord-date">
                        <span>@_loc[nameof(RessourceAppStrings.date)]</span>
                        <div class="ek-ord-date-row">
                            <button type="button" class="ek-chip @(IsDate(0) ? "is-active" : "")" @onclick="() => SetDateOffset(0)">@_loc[nameof(RessourceAppStrings.orderDateToday)]</button>
                            <button type="button" class="ek-chip @(IsDate(-1) ? "is-active" : "")" @onclick="() => SetDateOffset(-1)">@_loc[nameof(RessourceAppStrings.orderDateYesterday)]</button>
                            <input type="date" class="ek-input" aria-label="@_loc[nameof(RessourceAppStrings.date)]" @bind="SelectedDateValue" />
                        </div>
                    </div>
                    <label class="ek-field ek-ord-provider">
                        <span>@_loc[nameof(RessourceAppStrings.provider)]</span>
                        <select class="ek-select" @bind="selectedProvider">
                            @foreach (var x in providers) {
                                <option value="@x.Guid">@x.Designation</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="ek-ord-filter">
                    <div class="ek-search">
                        <svg class="ek-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                        </svg>
                        <input type="text" inputmode="search" class="ek-search-input" autocomplete="off"
                               placeholder="@_loc[nameof(RessourceAppStrings.orderSearchPerson)]"
                               aria-label="@_loc[nameof(RessourceAppStrings.orderSearchPerson)]"
                               @bind="personFilter" @bind:event="oninput" />
                        @if (personFilter.Length > 0) {
                            <button type="button" class="ek-icon-btn" @onclick="() => personFilter = string.Empty"
                                    title="@_loc[nameof(RessourceAppStrings.clearSearch)]"
                                    aria-label="@_loc[nameof(RessourceAppStrings.clearSearch)]">✕</button>
                        }
                    </div>
                    <button type="button" class="ek-chip @(onlyFilled ? "is-active" : "")" aria-pressed="@onlyFilled" @onclick="() => onlyFilled = !onlyFilled">
                        @_loc[nameof(RessourceAppStrings.orderOnlyFilled)] <span class="ek-chip-count">@FilledCount</span>
                    </button>
                </div>

                <ul class="ek-ord-list">
                    @foreach (Person x in ShownPersons) {
                        Person current = x;
                        <OrderPersonRow @key="current.Guid" Person="current" SaldoOk="IsInconspicuous(current)"
                                        Text="@TextOf(current.Guid)" TextChanged="@((string v) => SetText(current.Guid, v))"
                                        Invalid="IsInvalid(current.Guid)" InputId="@InputIdOf(current)"
                                        OnEnter="() => FocusNext(current.Guid)"
                                        Quick="AppData.QuickAmounts" Last="LastOf(current.Guid)"
                                        OnAddAmount="@((long c) => AddQuick(current.Guid, c))" OnApplyLast="() => ApplyLast(current.Guid)"
                                        HistoryOpen="openHistory.Contains(current.Guid)" OnToggleHistory="() => ToggleHistory(current)">
                            @if (openHistory.Contains(current.Guid)) {
                                <div class="ek-ord-history">
                                    @if (loadingHistory.Contains(current.Guid)) {
                                        <ul class="ek-hist" aria-busy="true" aria-live="polite">
                                            @for (int i = 0; i < 3; i++) {
                                                <li class="ek-skeleton" aria-hidden="true"><span class="ek-skeleton-line"></span></li>
                                            }
                                        </ul>
                                    }
                                    else if (HistoryOf(current.Guid).Count == 0) {
                                        <p class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.orderNoOrdersYet)]</p>
                                    }
                                    else {
                                        <ul class="ek-hist">
                                            @foreach (Order o in HistoryOf(current.Guid)) {
                                                <li>
                                                    <span class="ek-hist-date">@o.DateTime.ToString("ddd, dd.MM.yyyy")</span>
                                                    <span class="ek-hist-text">@o.Provider.Designation</span>
                                                    <span class="ek-hist-amount">@o.Money.ToString()</span>
                                                </li>
                                            }
                                        </ul>
                                        <div class="ek-hist-more">
                                            <button type="button" class="ek-btn" @onclick="() => HistoryLoadInModal(current)">
                                                @_loc[nameof(RessourceAppStrings.viewCompleteHistory)]
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </OrderPersonRow>
                    }
                </ul>
                @if (person.Count > 0 && !ShownPersons.Any()) {
                    <div class="ek-empty">
                        <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noMatches)]</p>
                        <button type="button" class="ek-btn" @onclick="ClearPersonFilter">@_loc[nameof(RessourceAppStrings.resetFilter)]</button>
                    </div>
                }

                <div class="ek-ord-bar" role="region" aria-label="@_loc[nameof(RessourceAppStrings.order)]">
                    <p class="ek-ord-bar-text">
                        <strong>@Entries.Count</strong> @_loc[nameof(RessourceAppStrings.orderPersonsLabel)]
                        <span aria-hidden="true">·</span>
                        @_loc[nameof(RessourceAppStrings.orderSumLabel)] <strong>@Modells.Money.FromTotalCents(TotalCents).ToString()</strong>
                    </p>
                    <button type="button" class="ek-btn ek-btn-primary" disabled="@(isSubmitting || Entries.Count == 0)" @onclick="OpenPreview">
                        @_loc[nameof(RessourceAppStrings.orderReview)]
                    </button>
                </div>

                <EkDialog Open="previewOpen" Title="@_loc[nameof(RessourceAppStrings.orderPreviewTitle)]" OnClose="ClosePreview">
                    <ChildContent>
                        <p class="ek-ord-prev-meta">
                            <span>@selectedDate.ToString("dddd, dd.MM.yyyy")</span>
                            <span aria-hidden="true">·</span>
                            <span>@SelectedProviderData?.Designation</span>
                        </p>
                        @if (existingOrdersOnDay > 0) {
                            <p class="ek-hint is-warn" role="alert">@string.Format(_loc[nameof(RessourceAppStrings.orderExistingWarn)], existingOrdersOnDay)</p>
                        }
                        <ul class="ek-ord-prev-list">
                            @foreach ((Person x, long cents) in Entries) {
                                <li>
                                    <span>@x.Name</span>
                                    <span class="ek-hist-amount">@Modells.Money.FromTotalCents(cents).ToString()</span>
                                </li>
                            }
                        </ul>
                        <p class="ek-ord-prev-sum">
                            @_loc[nameof(RessourceAppStrings.orderSumLabel)]: <strong>@Modells.Money.FromTotalCents(TotalCents).ToString()</strong>
                        </p>
                    </ChildContent>
                    <Footer>
                        <button type="button" class="ek-btn" disabled="@isSubmitting" @onclick="ClosePreview">@_loc[nameof(RessourceAppStrings.cancel)]</button>
                        <button type="button" class="ek-btn ek-btn-primary" disabled="@isSubmitting" @onclick="ConfirmOrder">@_loc[nameof(RessourceAppStrings.orderConfirmNow)]</button>
                    </Footer>
                </EkDialog>

                <EkDialog Open="historyDialogOpen" Wide="true" Title="@ModalTitle" OnClose="CloseHistoryDialog">
                    <ChildContent>
                        @if (completeHistoryFromOne.Count == 0) {
                            <p class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.orderNoOrdersYet)]</p>
                        }
                        @foreach (IGrouping<DateTime, Order> month in CompleteHistoryByMonth) {
                            <h4 class="ek-hist-month">@month.Key.ToString("MMMM yyyy")</h4>
                            <ul class="ek-hist">
                                @foreach (Order o in month) {
                                    <li>
                                        <span class="ek-hist-date">@o.DateTime.ToString("ddd, dd.MM.yyyy")</span>
                                        <span class="ek-hist-text">@o.Provider.Designation</span>
                                        <span class="ek-hist-amount">@o.Money.ToString()</span>
                                    </li>
                                }
                            </ul>
                        }
                    </ChildContent>
                    <Footer>
                        <button type="button" class="ek-btn" @onclick="CloseHistoryDialog">@_loc[nameof(RessourceAppStrings.close)]</button>
                    </Footer>
                </EkDialog>
            }
            else {
                <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.overview)]</h3>
                @if (overviewLoading && overviewDays.Count == 0) {
                    <ul class="ek-hist" aria-busy="true" aria-live="polite">
                        @for (int i = 0; i < 4; i++) {
                            <li class="ek-skeleton" aria-hidden="true"><span class="ek-skeleton-line"></span></li>
                        }
                    </ul>
                }
                else if (overviewDays.Count == 0) {
                    <div class="ek-empty">
                        <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.orderNoOrdersYet)]</p>
                    </div>
                }
                else {
                    <div class="ek-ovw-table" tabindex="0" role="region" aria-label="@_loc[nameof(RessourceAppStrings.overviewTableLabel)]">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col" class="ek-ovw-date">@_loc[nameof(RessourceAppStrings.date)]</th>
                                    @foreach (Person x in overviewPeople) {
                                        <th scope="col" class="ek-ovw-person" title="@x.Name">@x.Name</th>
                                    }
                                    <th scope="col" class="ek-ovw-sum">@_loc[nameof(RessourceAppStrings.orderSumLabel)]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (OrderOverviewDay day in overviewDays) {
                                    <tr class="@(IsWeekend(day.Date) ? "is-weekend" : "")">
                                        <th scope="row" class="ek-ovw-date">@day.Date.ToString("ddd dd.MM.yy")</th>
                                        @foreach (Person x in overviewPeople) {
                                            long cents = CentsOf(day, x);
                                            <td class="@(cents > 0 ? "has-order" : "no-order")">@(cents > 0 ? Modells.Money.FromTotalCents(cents).ToString() : "–")</td>
                                        }
                                        <td class="ek-ovw-sum">@Modells.Money.FromTotalCents(day.TotalCents).ToString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="ek-ovw-cards">
                        @foreach (OrderOverviewDay day in overviewDays) {
                            <section class="ek-ovw-card @(IsWeekend(day.Date) ? "is-weekend" : "")">
                                <header>
                                    <strong>@day.Date.ToString("dddd, dd.MM.yyyy")</strong>
                                    <span class="ek-hist-amount">@Modells.Money.FromTotalCents(day.TotalCents).ToString()</span>
                                </header>
                                <ul>
                                    @foreach (Person x in overviewPeople) {
                                        long cents = CentsOf(day, x);
                                        if (cents > 0) {
                                            <li>
                                                <span>@x.Name</span>
                                                <span>@Modells.Money.FromTotalCents(cents).ToString()</span>
                                            </li>
                                        }
                                    }
                                </ul>
                            </section>
                        }
                    </div>

                    <div class="ek-hist-more">
                        @if (noMoreToLoad) {
                            <span class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.endOfList)]</span>
                        }
                        else {
                            <button type="button" class="ek-btn" disabled="@overviewLoading" @onclick="LoadOrdersForOverview">
                                @_loc[nameof(RessourceAppStrings.buttonLoadMore)]
                            </button>
                            <p class="ek-hint">@_loc[nameof(RessourceAppStrings.lastDayMaybyIncomplete)]</p>
                        }
                    </div>
                }
            }
        </div>
    </Authorized>
</AuthorizeView>
