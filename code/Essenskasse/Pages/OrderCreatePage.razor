@page "/orderCreate"

@using Microsoft.AspNetCore.Components.QuickGrid;

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>@_loc[nameof(RessourceAppStrings.createNewOrder)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash ek-ord-page">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.createNewOrder)]</h2>

            <div class="ek-seg ek-seg-neutral ek-ord-tabs" role="tablist">
                <button type="button" role="tab" class="@(view == OrderView.Order ? "is-active" : "")" aria-selected="@(view == OrderView.Order)"
                        @onclick="() => ShowView(OrderView.Order)">@_loc[nameof(RessourceAppStrings.orderTabOrder)]</button>
                <button type="button" role="tab" class="@(view == OrderView.Overview ? "is-active" : "")" aria-selected="@(view == OrderView.Overview)"
                        @onclick="() => ShowView(OrderView.Overview)">@_loc[nameof(RessourceAppStrings.overview)]</button>
            </div>

            @if (view == OrderView.Order) {
                <div class="ek-add ek-ord-head">
                    <div class="ek-field ek-ord-date">
                        <span>@_loc[nameof(RessourceAppStrings.date)]</span>
                        <div class="ek-ord-date-row">
                            <button type="button" class="ek-chip @(IsDate(0) ? "is-active" : "")" @onclick="() => SetDateOffset(0)">@_loc[nameof(RessourceAppStrings.orderDateToday)]</button>
                            <button type="button" class="ek-chip @(IsDate(-1) ? "is-active" : "")" @onclick="() => SetDateOffset(-1)">@_loc[nameof(RessourceAppStrings.orderDateYesterday)]</button>
                            <input type="date" class="ek-input" aria-label="@_loc[nameof(RessourceAppStrings.date)]" @bind="SelectedDateValue" />
                        </div>
                    </div>
                    <label class="ek-field ek-ord-provider">
                        <span>@_loc[nameof(RessourceAppStrings.provider)]</span>
                        <select class="ek-select" @bind="selectedProvider">
                            @foreach (var x in providers) {
                                <option value="@x.Guid">@x.Designation</option>
                            }
                        </select>
                    </label>
                </div>

                @foreach (int i in Enumerable.Range(0, person.Count)) {
                    <div class="row" style="margin: 0.1rem; border: 0.1rem inset">
                        <div class="col-lg-12">
                            <div class="row"
                                 style="background-color: @(money[i].Equals(new Money(0, 0)) ? "transparent" : "#B3D9FF")">
                                <div class="col-lg-8">
                                    <PersonOrderCard @ref="@personOrderCards[i]" PersonName="@person[i].Name"
                                                     Money="@money[i]"
                                                     OnValuesChanged="(ChangedValues => HandleValuesChanged(i, ChangedValues))">
                                    </PersonOrderCard>
                                </div>
                                <div class="col-lg-2 align-self-center">
                                    <label>
                                        @money[i].ToString()
                                    </label>
                                </div>
                                <div class="col-lg-2 align-self-center">
                                    @if (showHistory[i]) {
                                        <button @onclick="() => LoadAndShowHistory(i)" type="button"
                                                class="btn btn-info float-end" data-dismiss="modal"
                                                style="border-radius:8px; margin-top: 2px;">
                                            @_loc[nameof(RessourceAppStrings.orderHistory)]
                                            @_loc[nameof(RessourceAppStrings.hide)]
                                        </button>
                                    }
                                    else {
                                        <button @onclick="() => LoadAndShowHistory(i)" type="button"
                                                class="btn btn-info float-end" data-dismiss="modal" style="border-radius:8px">
                                            @_loc[nameof(RessourceAppStrings.orderHistory)]
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                @if (showHistory[i]) {
                                    <div style="border: 0.5rem ridge; margin: 0.5rem;">
                                        <PersonOrderHistoryCard Orders="shownOrders[i]" />
                                        <div class="row" style="margin: 0.25rem;">
                                            <div class="col-lg-12">
                                                <button type="button" class="btn btn-info float-end"
                                                        style="border-radius:8px; width: fit-content;"
                                                        @onclick="() => HistoryLoadInModal(i)">
                                                    @_loc[nameof(RessourceAppStrings.viewCompleteHistory)]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <br />

                <div class="row justify-content-between">
                    <button type="button" class="btn-success" data-dismiss="modal" style="border-radius:8px"
                            @onclick="PostOrderForTheDay">
                        @_loc[nameof(RessourceAppStrings.submit)] @_loc[nameof(RessourceAppStrings.order)]
                    </button>
                </div>

                @*<button class="btn btn-primary" @onclick="() => ModalDialog.Open()">Click me!</button>*@
                <HistoryModalCard @ref="@ModalDialog" Title="@ModalTitle">
                    <div class="row">
                        <div style="height: 70vh; overflow: scroll">
                            @foreach (Order x in completeHistoryFromOne) {
                                <div class="row"
                                     style="margin-left: 1rem; margin-right: 1rem; border-color: black; border-bottom: solid 0.2px">
                                    <div class="col-lg-5">
                                        @x.DateTime.ToString("dddd, dd MMMM yyyy")
                                    </div>
                                    <div class="col-lg-2">
                                        @x.Money.ToString()
                                    </div>
                                    <div class="col-lg-5">
                                        @x.Provider.Designation
                                    </div>
                                </div>
                            }
                        </div>
                        <button class="btn btn-primary" @onclick="() => ModalDialog!.Close()">Close</button>
                    </div>
                </HistoryModalCard>
            }
            else {
                <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.overview)]</h3>
                <div class="overViewGrid">
                    @if (orderListForOverview.Count != 0) {
                        <QuickGrid Items="@orderListForOverview.AsQueryable()">
                            <PropertyColumn Property="@(p => p.DateTime.ToString("d"))"
                                            Title="@(orderListForOverview[0].Head[0])" />
                            @foreach (int i in Enumerable.Range(0, person.Count)) {
                                <PropertyColumn Property="@(p => OverviewCellFillContent(p.Orders[i]))"
                                                Title="@(orderListForOverview[0].Head[i + 1])" Class="text-center" />
                            }
                        </QuickGrid>
                    }
                </div>

                <button type="button" class="btn-primary" data-dismiss="modal"
                        style="border-radius:8px; margin-top: 1rem; opacity: @OpacityOfNoMoreToLoad%"
                        disabled="@noMoreToLoad" @onclick="LoadOrdersForOverview">
                    @_loc[nameof(RessourceAppStrings.buttonLoadMore)]
                </button>

                <hr />

                <label>
                    @_loc[nameof(RessourceAppStrings.lastDayMaybyIncomplete)]
                </label>

            }
        </div>
    </Authorized>
</AuthorizeView>
