@page "/"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject ILocalStorageService LocalStorage
@inject AppDataService AppData
@inject UserSettingsStore UserSettings
@inject ToastService ToastService
@inject TextService Texts

<PageTitle>@_loc[nameof(RessourceAppStrings.dashboard)]</PageTitle>

@{
    List<Person> noticeable = NoticeablePersons;
    List<Person> inconspicuous = InconspicuousPersons;
}

<div class="ek-dash ek-pg-dashboard">
    <header class="ek-head">
        <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.dashboard)]</h2>
        <div class="ek-actions">
            <label class="ek-switch">
                <input type="checkbox" role="switch" @bind="IsSingleListWish" />
                <span class="ek-switch-track" aria-hidden="true"></span>
                <span>@_loc[nameof(RessourceAppStrings.singleColumn)]</span>
            </label>
            @if (!IsSingleListWish) {
                <button type="button" class="ek-btn" @onclick="ToggleColumnInView">
                    @_loc[nameof(RessourceAppStrings.swapColumns)]
                </button>
            }
            <AuthorizeView>
                <Authorized>
                    <button type="button" class="ek-btn" @onclick="RecalculateSaldos">
                        @_loc[nameof(RessourceAppStrings.recalculateSaldo)]
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <section class="ek-hero" aria-labelledby="ek-cash-label">
        <div class="ek-hero-main">
            <p id="ek-cash-label" class="ek-hero-label">@_loc[nameof(RessourceAppStrings.cashBalanceCurrent)]</p>
            <p class="ek-hero-amount">@currentCashBalance.ToString()</p>
        </div>
        <div class="ek-hero-side">
            <div class="ek-roll" aria-hidden="true">
                @foreach (Person p in noticeable) {
                    <span class="ek-pip ek-pip-bad" title="@p.Name"></span>
                }
                @foreach (Person p in inconspicuous) {
                    <span class="ek-pip ek-pip-ok" title="@p.Name"></span>
                }
            </div>
            <p class="ek-legend">
                <span class="ek-legend-item"><span class="ek-dot ek-dot-bad"></span>@(noticeable.Count) @_loc[nameof(RessourceAppStrings.noticeable)]</span>
                <span class="ek-legend-item"><span class="ek-dot ek-dot-ok"></span>@(inconspicuous.Count) @_loc[nameof(RessourceAppStrings.inconspicuous)]</span>
            </p>
        </div>
    </section>

    <AuthorizeView>
        <Authorized>
            @if (MailCandidates.Count > 0) {
                <section class="ek-add ek-massmail">
                    <p class="ek-hint">@(string.Format(_loc[nameof(RessourceAppStrings.massMailInfo)].Value, noticeable.Count, MailCandidates.Count))</p>
                    <div class="ek-edit-actions">
                        @if (NextMailPerson is not null) {
                            <button type="button" class="ek-btn ek-btn-primary" @onclick="PrepareNextMail">
                                @(string.Format(_loc[nameof(RessourceAppStrings.massMailNext)].Value, NextMailPerson.Name, MailDone + 1, MailCandidates.Count))
                            </button>
                        }
                        else {
                            <span class="ek-edit-state">@_loc[nameof(RessourceAppStrings.massMailDone)]</span>
                        }
                        @if (mailed.Count > 0) {
                            <button type="button" class="ek-btn" @onclick="ResetMails">@_loc[nameof(RessourceAppStrings.massMailReset)]</button>
                        }
                    </div>
                </section>
            }
        </Authorized>
    </AuthorizeView>

    @if (IsSingleListWish) {
        <div class="ek-grid">
            @for (int i = 0; i < person.Count; i += 1) {
                <ShowPersonCard Person="person[i]" PositivSaldo="@positivSaldo.Contains(i)" />
            }
        </div>
    }
    else {
        <div class="ek-groups @(NoticeableOnRightSide ? "ek-swap" : "")">
            @if (noticeable.Count > 0) {
                <section class="ek-group ek-group-bad">
                    <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.noticeable)] <span class="ek-count">@(noticeable.Count)</span></h3>
                    <div class="ek-grid">
                        @foreach (Person p in noticeable) {
                            <ShowPersonCard Person="p" PositivSaldo="false" />
                        }
                    </div>
                </section>
            }
            @if (inconspicuous.Count > 0) {
                <section class="ek-group ek-group-ok">
                    <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.inconspicuous)] <span class="ek-count">@(inconspicuous.Count)</span></h3>
                    <div class="ek-grid">
                        @foreach (Person p in inconspicuous) {
                            <ShowPersonCard Person="p" PositivSaldo="true" />
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>
