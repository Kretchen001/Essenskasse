@page "/person"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject AuthStateService AuthState

<PageTitle>@_loc[nameof(RessourceAppStrings.person)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash">
        <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.person)]</h2>
        <div class="row">
            <h4 style="margin-top: 1rem;">
                @_loc[nameof(RessourceAppStrings.addPerson)]
            </h4>
            @if (!accessToAdd) {
                <button type="button" class="btn-primary" data-dismiss="modal" style="border-radius:8px; width: fit-content;" @onclick="() => {accessToAdd = true;}">
                    @_loc[nameof(RessourceAppStrings.addPerson)]
                </button>
            }
            else {
                <div class="col-lg-2">
                    <label style="vertical-align: middle;">
                        @_loc[nameof(RessourceAppStrings.add)]
                    </label>
                </div>
                <div class="col-lg-8">
                    <div class="row">
                        <input type="text" name="nameHinzuzufuegen" placeholder="@_loc[nameof(RessourceAppStrings.name)]" id="idHinzuzufuegen"
                               style="width: 100%;" @bind-value="newPersonName">
                    </div>
                    <div class="row">
                        <input type="email" name="nameHinzuzufuegen" placeholder="@_loc[nameof(RessourceAppStrings.email)]" id="idHinzuzufuegen"
                               style="width: 100%;" @bind-value="newPersonEmail">
                    </div>
                </div>
                <div class="col-lg-2">
                    <button @onclick="() => { AddNewPerson(); }">
                        @_loc[nameof(RessourceAppStrings.submit)]!
                    </button>
                </div>
            }
        </div>

        <br />

        <h4>@_loc[nameof(RessourceAppStrings.personRegistered)]</h4>
        @if (AppData.FilterShowPerson) {
            <div class="ek-search">
                <svg class="ek-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
                <input id="ek-person-search" type="text" inputmode="search" class="ek-search-input" autocomplete="off"
                       placeholder="@_loc[nameof(RessourceAppStrings.searchPersons)]"
                       aria-label="@_loc[nameof(RessourceAppStrings.searchPersons)]"
                       @bind="Filter" @bind:event="oninput" />
                @if (Filter.Length > 0) {
                    <span class="ek-search-count">@_loc[nameof(RessourceAppStrings.shownOfTotal), shownPersonList.Count, person.Count]</span>
                    <button type="button" class="ek-icon-btn" @onclick="ClearFilter"
                            title="@_loc[nameof(RessourceAppStrings.clearSearch)]"
                            aria-label="@_loc[nameof(RessourceAppStrings.clearSearch)]">✕</button>
                }
            </div>
        }
        <div class="ek-people-tools">
            <label class="ek-select-wrap">
                <span>@_loc[nameof(RessourceAppStrings.sortBy)]</span>
                <select class="ek-select" @bind="SortKey">
                    <option value="@nameof(PersonSortMode.NameAsc)">@_loc[nameof(RessourceAppStrings.sortNameAsc)]</option>
                    <option value="@nameof(PersonSortMode.NameDesc)">@_loc[nameof(RessourceAppStrings.sortNameDesc)]</option>
                    <option value="@nameof(PersonSortMode.SaldoAsc)">@_loc[nameof(RessourceAppStrings.sortSaldoAsc)]</option>
                    <option value="@nameof(PersonSortMode.SaldoDesc)">@_loc[nameof(RessourceAppStrings.sortSaldoDesc)]</option>
                    <option value="@nameof(PersonSortMode.NoEmailFirst)">@_loc[nameof(RessourceAppStrings.sortNoEmailFirst)]</option>
                </select>
            </label>
        </div>
        <div class="ek-grid ek-people">
            @foreach (Person x in shownPersonList) {
                <PersonListCard Person="x" PositivSaldo="IsInconspicuous(x)" />
            }
        </div>
        <div class="row">
            <h4 style="margin-top: 1rem;">
                @_loc[nameof(RessourceAppStrings.editPerson)]
            </h4>
            <EditPersonCard OnChangeCommit="ChangeOfPersonCommit" />
        </div>
        </div>
    </Authorized>
</AuthorizeView>
