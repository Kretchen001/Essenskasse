@page "/person"

@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject IConfiguration Config
@inject IStringLocalizer<App> _loc
@inject AppDataService AppData
@inject ToastService ToastService
@inject ILocalStorageService LocalStorage
@inject UserSettingsStore UserSettings
@inject NavigationManager Nav
@inject AuthStateService AuthState

<PageTitle>@_loc[nameof(RessourceAppStrings.person)]</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ek-dash ek-denied" role="alert">
            <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.accessDenied)]</h2>
            <p class="ek-denied-text">@_loc[nameof(RessourceAppStrings.accessDeniedHint)]</p>
            <div class="ek-denied-actions">
                <button type="button" class="ek-btn ek-btn-primary" @onclick="AuthState.RequestLogin">
                    @_loc[nameof(RessourceAppStrings.signIn)]
                </button>
                <button type="button" class="ek-btn" @onclick="() => Nav.NavigateTo(dashboardLink)">
                    @_loc[nameof(RessourceAppStrings.backToDashboard)]
                </button>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="ek-dash ek-pg-person">
        <h2 class="ek-title">@_loc[nameof(RessourceAppStrings.person)]</h2>
        <form class="ek-add" @onsubmit="AddNewPerson" @onsubmit:preventDefault>
            <h3 class="ek-group-title">@_loc[nameof(RessourceAppStrings.addPerson)]</h3>
            <div class="ek-add-fields">
                <label class="ek-field">
                    <span>@_loc[nameof(RessourceAppStrings.name)]</span>
                    <input @ref="newNameInput" type="text" class="ek-input" autocomplete="off"
                           @bind="newPersonName" @bind:event="oninput" />
                </label>
                <label class="ek-field">
                    <span>@_loc[nameof(RessourceAppStrings.email)]</span>
                    <input type="email" class="ek-input" autocomplete="off"
                           @bind="newPersonEmail" @bind:event="oninput" />
                </label>
                <button type="submit" class="ek-btn ek-btn-primary ek-add-submit" disabled="@(!CanAdd)">
                    @(NewNameDuplicate ? _loc[nameof(RessourceAppStrings.addAnyway)] : _loc[nameof(RessourceAppStrings.add)])
                </button>
            </div>
            @if (NewNameDuplicate) {
                <p class="ek-hint is-warn">@_loc[nameof(RessourceAppStrings.duplicateName)]</p>
            }
            @if (NewEmailInvalid) {
                <p class="ek-hint is-error">@_loc[nameof(RessourceAppStrings.emailInvalid)]</p>
            }
        </form>

        <h3 class="ek-group-title ek-list-title">@_loc[nameof(RessourceAppStrings.personRegistered)]</h3>
        @if (AppData.FilterShowPerson) {
            <div class="ek-search">
                <svg class="ek-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
                <input id="ek-person-search" type="text" inputmode="search" class="ek-search-input" autocomplete="off"
                       placeholder="@_loc[nameof(RessourceAppStrings.searchPersons)]"
                       aria-label="@_loc[nameof(RessourceAppStrings.searchPersons)]"
                       @bind="Filter" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                @if (Filter.Length == 0) {
                    <kbd class="ek-kbd" aria-hidden="true">/</kbd>
                }
                @if (IsFiltered) {
                    <span class="ek-search-count">@_loc[nameof(RessourceAppStrings.shownOfTotal), shownPersonList.Count, person.Count]</span>
                }
                @if (Filter.Length > 0) {
                    <button type="button" class="ek-icon-btn" @onclick="ClearFilter"
                            title="@_loc[nameof(RessourceAppStrings.clearSearch)]"
                            aria-label="@_loc[nameof(RessourceAppStrings.clearSearch)]">✕</button>
                }
            </div>
            <div class="ek-chips" role="group" aria-label="@_loc[nameof(RessourceAppStrings.filterByStatus)]">
                @foreach (PersonStatusFilter chip in chipOrder) {
                    <button type="button" class="ek-chip @(statusFilter == chip ? "is-active" : "")"
                            aria-pressed="@((statusFilter == chip).ToString().ToLowerInvariant())"
                            @onclick="() => SetStatusFilter(chip)">
                        @ChipLabel(chip) <span class="ek-chip-count">@ChipCount(chip)</span>
                    </button>
                }
            </div>
        }
        <div class="ek-people-tools">
            <label class="ek-select-wrap">
                <span>@_loc[nameof(RessourceAppStrings.sortBy)]</span>
                <select class="ek-select" @bind="SortKey">
                    <option value="@nameof(PersonSortMode.NameAsc)">@_loc[nameof(RessourceAppStrings.sortNameAsc)]</option>
                    <option value="@nameof(PersonSortMode.NameDesc)">@_loc[nameof(RessourceAppStrings.sortNameDesc)]</option>
                    <option value="@nameof(PersonSortMode.SaldoAsc)">@_loc[nameof(RessourceAppStrings.sortSaldoAsc)]</option>
                    <option value="@nameof(PersonSortMode.SaldoDesc)">@_loc[nameof(RessourceAppStrings.sortSaldoDesc)]</option>
                    <option value="@nameof(PersonSortMode.NoEmailFirst)">@_loc[nameof(RessourceAppStrings.sortNoEmailFirst)]</option>
                </select>
            </label>
        </div>
        @if (isLoading) {
            <div class="ek-grid ek-people" aria-busy="true" aria-live="polite">
                @for (int i = 0; i < 6; i++) {
                    <div class="ek-person ek-skeleton" aria-hidden="true">
                        <span class="ek-avatar"></span>
                        <div class="ek-person-text">
                            <span class="ek-skeleton-line"></span>
                            <span class="ek-skeleton-line is-short"></span>
                        </div>
                    </div>
                }
            </div>
        }
        else if (loadFailed) {
            <div class="ek-empty" role="alert">
                <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.loadFailed)]</p>
                <button type="button" class="ek-btn ek-btn-primary" @onclick="RetryLoadAsync">@_loc[nameof(RessourceAppStrings.retry)]</button>
            </div>
        }
        else if (person.Count == 0) {
            <div class="ek-empty">
                <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noPersonsYet)]</p>
                <p class="ek-empty-text">@_loc[nameof(RessourceAppStrings.noPersonsYetHint)]</p>
            </div>
        }
        else if (shownPersonList.Count == 0) {
            <div class="ek-empty">
                <p class="ek-empty-title">@_loc[nameof(RessourceAppStrings.noMatches)]</p>
                <button type="button" class="ek-btn" @onclick="ResetFilters">@_loc[nameof(RessourceAppStrings.resetFilter)]</button>
            </div>
        }
        else {
            <div class="ek-grid ek-people">
                @foreach (Person x in shownPersonList) {
                    <PersonListCard Person="x" PositivSaldo="IsInconspicuous(x)" OnUpdated="OnPersonUpdated" OnHidden="OnPersonHidden" />
                }
            </div>
        }

        <button type="button" class="ek-btn ek-hidden-toggle" aria-expanded="@showHidden" @onclick="ToggleHiddenAsync">
            @(showHidden ? _loc[nameof(RessourceAppStrings.hideHiddenPersons)] : _loc[nameof(RessourceAppStrings.showHiddenPersons)])
        </button>
        @if (showHidden) {
            @if (hiddenPersons.Count == 0) {
                <p class="ek-detail-empty">@_loc[nameof(RessourceAppStrings.noHiddenPersons)]</p>
            }
            else {
                <div class="ek-grid ek-people ek-people-hidden">
                    @foreach (Person x in hiddenPersons) {
                        <article class="ek-person ek-person-muted">
                            <span class="ek-avatar" aria-hidden="true">@PersonText.Initials(x.Name)</span>
                            <div class="ek-person-text">
                                <h4 class="ek-person-name">@x.Name</h4>
                                <p class="ek-person-sub">@x.Saldo.ToString()</p>
                            </div>
                            <button type="button" class="ek-btn" @onclick="() => RestorePersonAsync(x)">
                                @_loc[nameof(RessourceAppStrings.restore)]
                            </button>
                        </article>
                    }
                </div>
            }
        }
        </div>
    </Authorized>
</AuthorizeView>
