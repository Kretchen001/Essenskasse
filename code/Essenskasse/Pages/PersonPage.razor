@page "/person"

@inject IStringLocalizer<App> _loc

<style>
    table, th, td {
        border: 1px solid gray;
    }

    th:nth-child(1), td:nth-child(1) {
        width: 30% !important; /* First row 30% width */
    }

    th:nth-child(2), td:nth-child(2) {
        width: 30% !important; /* Secound row 30% width (60%) */
    }

    th:nth-child(3), td:nth-child(3) {
        width: 40% !important; /* Third row 40% width (100%) */
    }
</style>

<PageTitle>@_loc[nameof(RessourceAppStrings.person)]</PageTitle>

<h2>@_loc[nameof(RessourceAppStrings.person)]</h2>
<div class="row">
    <h4 style="margin-top: 1rem;">
        @_loc[nameof(RessourceAppStrings.addPerson)]
    </h4>
    @if (!accessToAdd) {
        <button style="width: fit-content;"
        @onclick="() => {accessToAdd = true;}">
            Neue Person hinzufügen.
        </button>
    }
    else {
        <div class="col-lg-2">
            <label style="vertical-align: middle;">
                Hinzuzufügen
            </label>
        </div>
        <div class="col-lg-8">
            <div class="row">
                <input type="text" name="nameHinzuzufuegen" placeholder="Name" id="idHinzuzufuegen"
                       style="width: 100%;" @bind-value="newPersonName">
            </div>
            <div class="row">
                <input type="text" name="nameHinzuzufuegen" placeholder="E-Mail" id="idHinzuzufuegen"
                       style="width: 100%;" @bind-value="newPersonEmail">
            </div>
        </div>
        <div class="col-lg-2">
            <button @onclick="() => { addNewPerson(); }">
                Abschicken!
            </button>
        </div>
    }
</div>
<div class="row">
    <h4 style="margin-top: 1rem;">
        Personen registriert
    </h4>
    <table>
        <tr>
            <th style="padding-left: 5px;">Guid</th>
            <th style="padding-left: 5px;">Name</th>
            <th style="padding-left: 5px;">E-Mail</th>
        </tr>
        @foreach (var x in person) {
            <tr>
                <td style="padding-left: 5px;">@x.Guid</td>
                <td style="padding-left: 5px;">@x.Name</td>
                <td style="padding-left: 5px;">@x.Email</td>
            </tr>
        }
    </table>
</div>

@code {
    private bool accessToAdd = false;

    private string newPersonName = "";
    private string newPersonEmail = "";

    private List<Person> person = new List<Person>();

    protected override async Task OnInitializedAsync () {
        // Request all Person, that are saved in the database
        HttpRequestMessage httpRequestMessage = new HttpRequestMessage() {
                Method = HttpMethod.Get,
                RequestUri = new Uri(Config["API-Adress"] + "person/requestAll")
            };

        HttpResponseMessage response = await HttpClient.SendAsync(httpRequestMessage);

        if (response.IsSuccessStatusCode) {
            person = JsonConvert.DeserializeObject<List<Person>>(await response.Content.ReadAsStringAsync()) ?? new List<Person>();
            person.ForEach(x => x.Name = Uri.UnescapeDataString(x.Name));
            person.ForEach(x => x.Email = Uri.UnescapeDataString(x.Email));
        }
    }

    private async void addNewPerson() {
        if (newPersonName.Equals("")) {
            return;
        }
    }
}