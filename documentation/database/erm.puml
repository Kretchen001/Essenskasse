@startuml Database

    entity Provider <<Anbieter>>  {
        * Guid : Guid <<PK>>
        --
        * Designator : string
    }

    entity Person {
        * Guid : Guid <<PK>>
        --
        * Name : string
        * Email : string
        * Saldo : Money
        saldo : Money

    }

    entity Order <<Bestellung>> {
        * Guid : Guid <<PK>>
        --
        * ReferencedPerson : Guid <<FK>>
        * DateTime : DateTime
        * Money : Money
        * Provider : Anbieter
    }

    entity Payment <<Einzahlung>> {
        * Guid : Guid <<PK>>
        --
        * ReferencedPerson : Guid <<FK>>
        * DateTime : DateTime
        * Money : Money
    }

    entity User <<Benutzer>> {
        * Guid : Guid <<PK>>
        --
        * Name : string
        * UserName : string
        * Pwd : string
        * Email : string
        * Role : short
    }

    entity SessionToken {
        * Guid : Guid <<PK>>
        --
        * UserGuid : Guid <<FK>>
        * ExpaireDate : DateTime
    }

    Order }o-right-|| Person : n..1
    Payment }o-left-|| Person : 1..m
    Order }o-down-|| Provider : n..1

    SessionToken }o--|| User : 1..m

@enduml